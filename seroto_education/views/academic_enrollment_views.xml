<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academic_enrollment_search" model="ir.ui.view">
        <field name="name">academic.enrollment.search</field>
        <field name="model">academic.enrollment</field>
        <field name="arch" type="xml">
            <search string="Ghi danh">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="course_id"/>
                <filter string="Chờ thanh toán" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Đã ghi danh" name="filter_enrolled" domain="[('state', '=', 'enrolled')]"/>
                <filter string="Bảo lưu" name="filter_suspended" domain="[('state', '=', 'suspended')]"/>
                <filter string="Hoàn thành" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Đã hủy" name="filter_cancel" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <group>
                    <filter string="Lớp học" name="group_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Khóa học" name="group_course" context="{'group_by': 'course_id'}"/>
                    <filter string="Trạng thái" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_academic_enrollment" model="ir.actions.act_window">
        <field name="name">Ghi danh</field>
        <field name="res_model">academic.enrollment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_academic_enrollment_search"/>
    </record>

    <record id="view_academic_enrollment_list" model="ir.ui.view">
        <field name="name">academic.enrollment.list</field>
        <field name="model">academic.enrollment</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="state == 'draft'" decoration-success="state == 'completed'" decoration-warning="state == 'suspended'">
                <field name="date_enroll"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="course_id"/>
                <field name="sale_order_id"/>
                <field name="progress" widget="progressbar"/>
                <field name="sessions_summary" string="Đã học"/>
                <field name="sessions_zoom_summary" string="Zoom" optional="show"/>
                <field name="sessions_bth_summary" string="BTH" optional="show"/>
                <field name="score"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-primary="state == 'enrolled'" decoration-warning="state == 'suspended'" decoration-success="state == 'completed'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_academic_enrollment_form" model="ir.ui.view">
        <field name="name">academic.enrollment.form</field>
        <field name="model">academic.enrollment</field>
        <field name="arch" type="xml">
            <form create="0" string="Ghi danh">
                <header>
                    <button name="action_complete" string="Hoàn thành &amp; Cấp chứng chỉ" type="object" class="oe_highlight" invisible="state != 'enrolled'"/>
                    <button name="action_suspend" string="Bảo lưu" type="object" class="btn-warning" invisible="state != 'enrolled'"/>
                    <button name="action_resume" string="Tiếp tục học" type="object" class="btn-primary" invisible="state != 'suspended'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,enrolled,suspended,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_certificate" type="object" class="oe_stat_button"
                                icon="fa-certificate" invisible="not certificate_ids">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Chứng chỉ</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group string="Thông tin ghi danh">
                            <field name="date_enroll"/>
                            <field name="student_id"/>
                            <field name="class_id"/>
                            <field name="course_id"/>
                        </group>
                        <group string="Kết quả &amp; Tiến trình">
                            <field name="sale_order_id" readonly="1"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="sessions_summary" string="Số buổi đã học"/>
                            <field name="sessions_zoom_summary" string="Điểm danh Zoom"/>
                            <field name="sessions_bth_summary" string="Điểm danh BTH"/>
                            <field name="score"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ghi chú kết quả">
                            <field name="note" placeholder="Nhập ghi chú kết quả học tập, đánh giá năng lực học viên tại đây..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
