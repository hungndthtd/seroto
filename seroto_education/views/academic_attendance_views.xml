<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View -->
    <record id="view_academic_attendance_search" model="ir.ui.view">
        <field name="name">academic.attendance.search</field>
        <field name="model">academic.attendance</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm điểm danh">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="course_id"/>
                <field name="session_id"/>
                
                <filter string="Có mặt" name="present" domain="[('state', '=', 'present')]"/>
                <filter string="Muộn" name="late" domain="[('state', '=', 'late')]"/>
                <filter string="Vắng không phép" name="absent_noperm" domain="[('state', '=', 'absent_noperm')]"/>
                <filter string="Vắng có phép" name="absent_perm" domain="[('state', '=', 'absent_perm')]"/>
                
                <group>
                    <filter string="Khóa học" name="group_by_course" context="{'group_by': 'course_id'}"/>
                    <filter string="Lớp học" name="group_by_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Buổi học" name="group_by_session" context="{'group_by': 'session_id'}"/>
                    <filter string="Học viên" name="group_by_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Trạng thái" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Ngày học" name="group_by_date" context="{'group_by': 'date_start'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_academic_attendance_list" model="ir.ui.view">
        <field name="name">academic.attendance.list</field>
        <field name="model">academic.attendance</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="course_id"/>
                <field name="class_id"/>
                <field name="session_id"/>
                <field name="date_start"/>
                <field name="student_id"/>
                <field name="state" widget="badge" decoration-success="state == 'present'" decoration-warning="state == 'late'" decoration-danger="state == 'absent_noperm'" decoration-info="state == 'absent_perm'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_academic_attendance_form" model="ir.ui.view">
        <field name="name">academic.attendance.form</field>
        <field name="model">academic.attendance</field>
        <field name="arch" type="xml">
            <form string="Điểm danh">
                <sheet>
                    <group>
                        <group>
                            <field name="course_id"/>
                            <field name="class_id"/>
                            <field name="session_id"/>
                        </group>
                        <group>
                            <field name="student_id"/>
                            <field name="date_start"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_academic_attendance" model="ir.actions.act_window">
        <field name="name">Điểm danh</field>
        <field name="res_model">academic.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_academic_attendance_search"/>
        <field name="context">{'search_default_group_by_class': 1}</field>
    </record>
</odoo>
