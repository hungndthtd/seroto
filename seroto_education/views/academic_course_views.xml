<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action -->
    <record id="action_academic_course" model="ir.actions.act_window">
        <field name="name">Khóa học</field>
        <field name="res_model">academic.course</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo khóa học mới đầu tiên!
            </p>
        </field>
    </record>

    <!-- List View -->
    <record id="view_academic_course_list" model="ir.ui.view">
        <field name="name">academic.course.list</field>
        <field name="model">academic.course</field>
        <field name="arch" type="xml">
            <list string="Khóa học">
                <field name="code"/>
                <field name="name"/>
                <field name="lecturer"/>
                <field name="format"/>
                <field name="batch_info"/>
                <field name="schedule_date"/>
                <field name="product_id"/>
                <field name="is_published" widget="boolean_toggle" string="Hiển thị trên Website"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_academic_course_form" model="ir.ui.view">
        <field name="name">academic.course.form</field>
        <field name="model">academic.course</field>
        <field name="arch" type="xml">
            <form string="Khóa học">
                <header>
                    <button name="action_open_new_batch" string="Mở đợt học mới" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Tên khóa học..."/>
                        </h1>
                        <field name="is_published" widget="boolean_toggle"/>
                        <label for="is_published"/>
                    </div>
                    <group>
                        <group string="Thông tin chung">
                            <field name="code"/>
                            <field name="slogan"/>
                            <field name="lecturer"/>
                            <field name="format"/>
                            <field name="product_id"/>
                            <field name="detail_url" widget="url" placeholder="VD: /khoa-hoc-eq-5-phut"/>
                        </group>
                        <group string="Thông tin tuyển sinh (Website)">
                            <field name="batch_info"/>
                            <field name="schedule_date"/>
                            <field name="schedule_time"/>
                            <field name="deadline_register"/>
                        </group>
                    </group>
                    <group>
                        <group string="Lớp đang nhận đăng ký">
                            <field name="default_class_id"/>
                            <!-- Chỉ hiện để xem, không sửa tay được - tự tính theo đúng
                                 trạng thái của default_class_id (xem academic_course.py).
                                 Muốn đổi, vào Lớp học bấm Mở/Đóng đăng ký. -->
                            <field name="is_registration_open" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Đợt học &amp; Lớp học">
                            <field name="class_ids" readonly="1">
                                <list decoration-success="state == 'open'" decoration-muted="state in ('closed', 'done')">
                                    <field name="name"/>
                                    <field name="intake_id"/>
                                    <field name="teacher_ids" widget="many2many_tags"/>
                                    <field name="date_start_planned" string="BĐ dự kiến"/>
                                    <field name="date_end_planned" string="KT dự kiến"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Mô tả chi tiết">
                            <field name="description" placeholder="Nhập nội dung giới thiệu khóa học..."/>
                        </page>
                        <page string="Khu vực hiển thị trên website">
                            <field name="audience_ids">
                                <list>
                                    <field name="name" string="Tên khu vực"/>
                                    <field name="code" string="Mã khu vực"/>
                                </list>
                            </field>
                        </page>
                        <page string="Câu hỏi chuyên sâu">
                            <field name="question_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="question" placeholder="Nhập câu hỏi..."/>
                                    <field name="question_type"/>
                                    <field name="options"
                                           placeholder="Mỗi lựa chọn 1 dòng..."
                                           invisible="question_type == 'text'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_academic_course_kanban" model="ir.ui.view">
        <field name="name">academic.course.kanban</field>
        <field name="model">academic.course</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="lecturer"/>
                <field name="batch_info"/>
                <field name="image_128"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-row gap-3">
                            <div class="o_kanban_image" style="width: 80px; height: 80px; min-width: 80px;">
                                <img t-attf-src="/web/image/academic.course/#{record.id.raw_value}/image_128"
                                     alt="Course Image"
                                     class="w-100 h-100 rounded object-fit-cover"/>
                            </div>
                            <div class="oe_kanban_details d-flex flex-column justify-content-between">
                                <div>
                                    <strong class="o_kanban_record_title">
                                        <span t-if="record.code.raw_value">[<field name="code"/>] </span>
                                        <field name="name"/>
                                    </strong>
                                    <div class="text-muted"><field name="lecturer"/></div>
                                </div>
                                <div class="badge rounded-pill text-bg-info text-wrap align-self-start mt-2">
                                    <field name="batch_info"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- === Khu vực hiển thị (Website) === -->

    <record id="view_academic_course_audience_list" model="ir.ui.view">
        <field name="name">academic.course.audience.list</field>
        <field name="model">academic.course.audience</field>
        <field name="arch" type="xml">
            <list string="Khu vực hiển thị" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Tên khu vực"/>
                <field name="code" string="Mã khu vực"/>
            </list>
        </field>
    </record>

    <record id="view_academic_course_audience_form" model="ir.ui.view">
        <field name="name">academic.course.audience.form</field>
        <field name="model">academic.course.audience</field>
        <field name="arch" type="xml">
            <form string="Khu vực hiển thị">
                <sheet>
                    <group>
                        <field name="name" placeholder="VD: Giáo viên"/>
                        <field name="code" placeholder="VD: teacher"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_academic_course_audience" model="ir.actions.act_window">
        <field name="name">Khu vực hiển thị</field>
        <field name="res_model">academic.course.audience</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có khu vực hiển thị nào!
            </p>
            <p>
                Mỗi khu vực có 1 Mã kỹ thuật (vd "teacher") - dùng để lọc khóa học ở
                snippet "Khóa học - Khu vực hiển thị" trên website.
            </p>
        </field>
    </record>
</odoo>
