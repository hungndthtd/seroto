<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Partner Form View -->
    <record id="view_partner_form_inherit_seroto" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.seroto</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add is_student field to form -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="student_code" readonly="1" invisible="not is_student" groups="base.group_user"/>
            </xpath>
            <!--
                Field "Company" gốc (parent_id, domain is_company=True) chỉ đúng ngữ nghĩa
                khi liên hệ cha THẬT SỰ là công ty (VD nhân sự thuộc 1 công ty, hoặc liên hệ
                của nơi tổ chức offline) - KHÔNG đổi/ảnh hưởng gì tới các trường hợp đó.

                Riêng luồng "Đăng ký hộ" (xem vtt_seroto_website/models/course_registration.py
                _find_or_create_student_partner + sale_order.py student_id) lại TÁI SỬ DỤNG
                đúng field parent_id để nối Học viên (VD "Bé An") với Người đăng ký (VD "Chị
                Hoa") - một liên hệ CÁ NHÂN, không phải công ty. Field gốc vẫn hiện đúng do
                domain chỉ áp dụng lúc CHỌN qua UI, không chặn giá trị gán thẳng qua code, nên
                hiện nhãn "Company" sai ngữ cảnh (Chị Hoa không phải công ty) như đã gặp thực tế.

                Giải pháp: ẩn field gốc + hiện thêm 1 field parent_id KHÁC (chỉ đổi label,
                readonly - sửa quan hệ Phụ huynh/Học viên phải qua đúng luồng Đơn hàng, không
                sửa tay ở đây) khi parent_id đã có giá trị và KHÔNG phải công ty.

                Dùng field PHẲNG "parent_is_company" (models/res_partner.py) thay vì tham
                chiếu lồng "parent_id.is_company" trực tiếp trong invisible - đã gặp thực tế:
                view client không fetch tin cậy field lồng qua Many2one khi chỉ xuất hiện
                trong biểu thức invisible (không có <field> nào khác kéo nó vào spec), khiến
                điều kiện luôn coi như false. Field phẳng đảm bảo luôn có giá trị đúng.
            -->
            <xpath expr="//field[@name='parent_id']" position="before">
                <field name="parent_is_company" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="invisible">((is_company and not parent_id) or company_name) and company_name != '' or (parent_id and not parent_is_company)</attribute>
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="parent_id" string="Liên hệ cha" readonly="1"
                       invisible="not parent_id or parent_is_company"/>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_student" readonly="1" groups="base.group_user"/>
                <field name="is_teacher"/>
                <field name="is_volunteer" readonly="1" groups="base.group_user"/>
                <field name="birthdate"/>
                <field name="occupation"/>
                <field name="current_course_ids" widget="many2many_tags" string="Đang học"/>
                <field name="completed_course_ids" widget="many2many_tags" string="Đã học"/>
            </xpath>
            <!-- Add Academic History tab to Notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Lịch sử Học tập" name="academic_history" invisible="not is_student">
                    <field name="enrollment_ids" readonly="1">
                        <list>
                            <field name="course_id"/>
                            <field name="class_id"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="sessions_summary" string="Số buổi đã học"/>
                            <field name="sessions_zoom_summary" string="Zoom" optional="show"/>
                            <field name="sessions_bth_summary" string="BTH" optional="show"/>
                            <field name="score"/>
                            <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'completed'" decoration-warning="state == 'suspended'"/>
                        </list>
                    </field>
                </page>
                <page string="Đã phụng sự" name="volunteer_history" invisible="not is_volunteer">
                    <field name="served_class_ids" readonly="1">
                        <list>
                            <field name="course_id"/>
                            <field name="intake_id" string="Khóa/Đợt"/>
                            <field name="state" widget="badge" decoration-success="state == 'open'" decoration-muted="state in ('closed', 'done')"/>
                        </list>
                    </field>
                </page>
                <page string="Lớp giảng dạy" name="teaching_history" invisible="not is_teacher">
                    <field name="taught_class_ids" readonly="1">
                        <list>
                            <field name="course_id"/>
                            <field name="intake_id" string="Khóa/Đợt"/>
                            <field name="date_start_planned" string="Ngày bắt đầu"/>
                            <field name="date_end_planned" string="Ngày kết thúc"/>
                            <field name="state" widget="badge" decoration-success="state == 'open'" decoration-muted="state in ('closed', 'done')"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit Partner Search View to add filter -->
    <record id="view_res_partner_filter_inherit_seroto" model="ir.ui.view">
        <field name="name">res.partner.select.inherit.seroto</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter string="Là học viên" name="is_student" domain="[('is_student', '=', True)]"/>
                <filter string="Là người phụng sự" name="is_volunteer" domain="[('is_volunteer', '=', True)]"/>
                <separator/>
                <filter string="Khóa đang học" name="group_current_course" context="{'group_by': 'current_course_ids'}"/>
                <filter string="Khóa đã học" name="group_completed_course" context="{'group_by': 'completed_course_ids'}"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- Custom Student Kanban View -->
    <record id="view_partner_kanban_academic" model="ir.ui.view">
        <field name="name">res.partner.kanban.academic</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban" create="0">
                <field name="id"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="parent_id"/>
                <field name="student_code"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-row p-3 gap-3">
                            <div class="o_kanban_image" style="width: 60px; height: 60px; min-width: 60px;">
                                <img t-attf-src="/web/image/res.partner/#{record.id.raw_value}/avatar_128"
                                     alt="Student Image"
                                     class="w-100 h-100 rounded-circle object-fit-cover"/>
                            </div>
                            <div class="oe_kanban_details d-flex flex-column">
                                <strong class="o_kanban_record_title">
                                    <span t-if="record.student_code.raw_value">[<field name="student_code"/>] </span>
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted small" t-if="record.parent_id.raw_value">
                                    Phụ huynh: <field name="parent_id"/>
                                </div>
                                <div class="text-muted small" t-if="record.phone.raw_value">
                                    SĐT: <field name="phone"/>
                                </div>
                                <div class="text-muted small" t-if="record.email.raw_value">
                                    Email: <field name="email"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Custom Student List View -->
    <record id="view_partner_list_academic" model="ir.ui.view">
        <field name="name">res.partner.list.academic</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Học viên" create="0">
                <field name="student_code"/>
                <field name="name"/>
                <field name="parent_id" string="Phụ huynh/Người bảo hộ"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="street" string="Địa chỉ" optional="show"/>
                <field name="state_id" string="Tỉnh/Thành phố" optional="show"/>
                <field name="city" optional="hide"/>
                <field name="current_course_ids" widget="many2many_tags" string="Đang học" optional="show"/>
                <field name="completed_course_ids" widget="many2many_tags" string="Đã học" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Custom Student Form View (Simplified) -->
    <record id="view_partner_form_academic" model="ir.ui.view">
        <field name="name">res.partner.form.academic</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Học viên">
                <sheet>
                    <field name="avatar_128" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title">
                        <field name="student_code"/>                        
                        <field name="name" string="Tên học viên" placeholder="Tên học viên..."/>                        
                        <field name="is_student" invisible="1"/>
                        <field name="student_code" invisible="1"/>
                    </div>
                    <group>
                        <group string="Thông tin liên hệ">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="parent_id" string="Phụ huynh/Người bảo hộ" domain="[('is_company', '=', False)]" context="{'default_is_company': False}"/>
                        </group>
                        <group string="Thông tin cá nhân">
                            <field name="birthdate"/>
                            <field name="occupation"/>
                            <field name="street" string="Địa chỉ" placeholder="Địa chỉ chi tiết (Số nhà, Đường...)"/>
                            <field name="state_id" string="Tỉnh/Thành phố" placeholder="Tỉnh/Thành phố" options="{'no_open': True, 'no_create': True}"/>
                            <field name="country_id" placeholder="Quốc gia" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tình trạng học tập">
                            <field name="current_course_ids" widget="many2many_tags" string="Đang học"/>
                            <field name="completed_course_ids" widget="many2many_tags" string="Đã học"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lịch sử Học tập" name="academic_history">
                            <field name="enrollment_ids" readonly="1">
                                <list>
                                    <field name="course_id"/>
                                    <field name="class_id"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="sessions_summary" string="Số buổi đã học"/>
                                    <field name="sessions_zoom_summary" string="Zoom" optional="show"/>
                                    <field name="sessions_bth_summary" string="BTH" optional="show"/>
                                    <field name="score"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'completed'" decoration-warning="state == 'suspended'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action for Students -->
    <record id="action_academic_student" model="ir.actions.act_window">
        <field name="name">Học viên</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_student', '=', True)]</field>
        <field name="context">{'default_is_student': True, 'default_is_company': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Không tìm thấy học viên nào!
            </p>
            <p>
                Học viên sẽ tự động xuất hiện tại đây khi họ đăng ký lớp học thành công từ Đơn bán hàng.
            </p>
        </field>
    </record>

    <!-- Link Custom List View to Student Action -->
    <record id="action_academic_student_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_partner_list_academic"/>
        <field name="act_window_id" ref="action_academic_student"/>
    </record>

    <!-- Link Custom Kanban View to Student Action -->
    <record id="action_academic_student_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_partner_kanban_academic"/>
        <field name="act_window_id" ref="action_academic_student"/>
    </record>

    <!-- Link Custom Form View to Student Action -->
    <record id="action_academic_student_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="30"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_partner_form_academic"/>
        <field name="act_window_id" ref="action_academic_student"/>
    </record>

    <!-- ==================================================================
         Người phụng sự ("Angelina") - tình nguyện viên không lương, hỗ trợ
         vài việc nhỏ cho Ban tổ chức. Phase 1: chỉ để nội bộ tra cứu/thống
         kê (email, sđt, ngày sinh, địa chỉ, khóa đã học, khóa đã phụng sự) -
         KHÔNG cấp tài khoản đăng nhập cho nhóm này.
         ================================================================== -->

    <record id="view_partner_list_volunteer" model="ir.ui.view">
        <field name="name">res.partner.list.volunteer</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Người phụng sự" create="0">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="birthdate"/>
                <field name="street" string="Địa chỉ" optional="show"/>
                <field name="current_course_ids" widget="many2many_tags" string="Đang học" optional="show"/>
                <field name="completed_course_ids" widget="many2many_tags" string="Đã học" optional="show"/>
                <field name="served_class_ids" widget="many2many_tags" string="Đã phụng sự"/>
            </list>
        </field>
    </record>

    <record id="view_partner_form_volunteer" model="ir.ui.view">
        <field name="name">res.partner.form.volunteer</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Người phụng sự">
                <sheet>
                    <field name="avatar_128" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title">
                        <field name="name" string="Tên" placeholder="Họ và tên..."/>
                        <field name="is_volunteer" invisible="1"/>
                    </div>
                    <group>
                        <group string="Thông tin liên hệ">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="birthdate"/>
                        </group>
                        <group string="Địa chỉ">
                            <field name="street" string="Địa chỉ" placeholder="Địa chỉ chi tiết (Số nhà, Đường...)"/>
                            <field name="state_id" string="Tỉnh/Thành phố" options="{'no_open': True, 'no_create': True}"/>
                            <field name="country_id" placeholder="Quốc gia" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tình trạng học tập">
                            <field name="current_course_ids" widget="many2many_tags" string="Đang học"/>
                            <field name="completed_course_ids" widget="many2many_tags" string="Đã học"/>
                        </group>
                        <group string="Phụng sự">
                            <field name="served_class_ids" widget="many2many_tags" string="Đã phụng sự"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_academic_volunteer" model="ir.actions.act_window">
        <field name="name">Người phụng sự</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_volunteer', '=', True)]</field>
        <field name="context">{'default_is_company': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có người phụng sự nào!
            </p>
            <p>
                Người phụng sự tự động xuất hiện tại đây khi được thêm vào field "Người phụng sự" của 1 Lớp học.
            </p>
        </field>
    </record>

    <record id="action_academic_volunteer_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_partner_list_volunteer"/>
        <field name="act_window_id" ref="action_academic_volunteer"/>
    </record>

    <record id="action_academic_volunteer_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_partner_form_volunteer"/>
        <field name="act_window_id" ref="action_academic_volunteer"/>
    </record>
</odoo>
