<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Thêm cột "Lớp học" vào dòng hóa đơn (cả bán hàng lẫn nhà cung cấp) - Kế toán chọn
        đúng lớp khi ghi chi phí (Hóa đơn nhà cung cấp) để tính "Chi" theo lớp trong Báo
        cáo tổng hợp (academic_report_metric.py). Xem account_move.py, class_id.
    -->
    <record id="view_account_move_form_inherit_seroto" model="ir.ui.view">
        <field name="name">account.move.form.inherit.seroto</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="class_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='product_id']" position="after">
                <field name="class_id"/>
            </xpath>
        </field>
    </record>
</odoo>
