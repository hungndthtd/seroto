<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_academic_certificate" model="ir.actions.act_window">
        <field name="name">Chứng chỉ</field>
        <field name="res_model">academic.certificate</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_academic_certificate_list" model="ir.ui.view">
        <field name="name">academic.certificate.list</field>
        <field name="model">academic.certificate</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="class_id"/>
                <field name="date_issue"/>
                <field name="grade"/>
            </list>
        </field>
    </record>

    <record id="view_academic_certificate_form" model="ir.ui.view">
        <field name="name">academic.certificate.form</field>
        <field name="model">academic.certificate</field>
        <field name="arch" type="xml">
            <form string="Chứng chỉ">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <label for="code"/>
                        <h2>
                            <field name="code"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="course_id"/>
                            <field name="class_id"/>
                        </group>
                        <group>
                            <field name="date_issue"/>
                            <field name="grade"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
