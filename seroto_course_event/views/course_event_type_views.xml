<odoo>
  <record id="course_event_type_tree" model="ir.ui.view">
    <field name="name">course.event.type.tree</field>
    <field name="model">course.event.type</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="color" widget="color_picker"/>
      </list>
    </field>
  </record>

  <!-- FORM VIEW -->
  <record id="course_event_type_form" model="ir.ui.view">
    <field name="name">course.event.type.form</field>
    <field name="model">course.event.type</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="color" widget="color_picker"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ACTION -->
  <record id="action_course_event_type" model="ir.actions.act_window">
    <field name="name">Course Types</field>
    <field name="res_model">course.event.type</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- MENU -->
  <menuitem
    id="menu_course_event_type"
    name="Course Types"
    parent="event.event_main_menu"
    action="action_course_event_type"
    sequence="100"
  />
</odoo>