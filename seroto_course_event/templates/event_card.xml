<odoo>
<template id="event_card">
        <div class="course-body">
          <div class="course-title">
            <t t-esc="event.name"/>
          </div>
          <div class="course-subtitle">
            <t t-esc="event.course_subtitle"/>
          </div>
          <div class="course-type">
            <t t-foreach="event.tag_ids" t-as="tag">
              <span t-attf-class="badge rounded-fill o_color_#{tag.color} me-1">
                <t t-esc="tag.name"/>
              </span>
            </t>
          </div>
          <div class="course-description">
            <t t-esc="event.course_description"/>
          </div>
          <div>
            <i class="fa fa-user"/>
            <t t-esc="event.teacher_partner_id.name"/>
          </div>
          <div>
            <i class="fa fa-book"/>
            Tuyển sinh: 
            <t t-esc="event.enrollment"/>
          </div>
          <div>
            <i class="fa fa-calendar"/>
            Ngày học:
            <t t-if="event.date_begin">
              <span class="course-special-color">            
                <t t-out="event.date_begin.strftime('%d/%m')"/> - 
                <t t-out="event.date_end.strftime('%d/%m')"/>
              </span>
            </t>
            <t t-else="">
              Sắp công bố
            </t>
          </div>
          <div>
            <i class="fa fa-clock-o"/>
            Giờ học:
            <t t-if="event.date_begin">
              <span class="course-special-color">
                <t t-out="event.date_begin.strftime('%H:%M')"/> - 
                <t t-out="event.date_end.strftime('%H:%M')"/>
              </span>
            </t>
            <t t-else="">
              Sắp công bố
            </t>
          </div>
          <div>
            <i class="fa fa-hourglass"/>
            Thời hạn đăng ký:
            <t t-if="event.registration_deadline">            
              <span class="course-special-color">
                <t t-esc="event.registration_deadline.strftime('%d/%m/%y')"/>
              </span>
            </t>
            <t t-else="">
              Sắp công bố
            </t>
          </div>
        </div>
</template>
</odoo>