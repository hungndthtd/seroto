<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zalo_zns_template_view_list" model="ir.ui.view">
        <field name="name">zalo.zns.template.list</field>
        <field name="model">zalo.zns.template</field>
        <field name="arch" type="xml">
            <list string="Mẫu tin ZNS">
                <field name="name"/>
                <field name="template_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="zalo_zns_template_view_form" model="ir.ui.view">
        <field name="name">zalo.zns.template.form</field>
        <field name="model">zalo.zns.template</field>
        <field name="arch" type="xml">
            <form string="Mẫu tin ZNS">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Tên mẫu"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_id"/>
                            <field name="active"/>
                            <field name="auto_send_event"/>
                        </group>
                        <group>
                            <!--
                              KHÔNG dùng class "oe_avatar" (ép cứng 90x90 qua CSS mặc định
                              của Odoo, xem devtools trong ảnh người dùng gửi) - để ảnh tự co
                              theo tỉ lệ gốc, chỉ giới hạn max-width, và căn trái (mặc định
                              oe_avatar canh giữa) sát với label "Ảnh xem trước".
                            -->
                            <field name="preview_image" widget="image"
                                   options="{'size': [0, 0]}"
                                   style="max-width:360px;width:auto;height:auto;margin:0;"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Ghi chú..."/>
                    <notebook>
                        <page string="Tham số">
                            <field name="param_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="key"/>
                                    <field name="field_source"/>
                                    <field name="custom_value" invisible="field_source != 'manual'"/>
                                    <field name="description"/>
                                    <field name="value_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zalo_zns_template_action" model="ir.actions.act_window">
        <field name="name">Mẫu tin ZNS</field>
        <field name="res_model">zalo.zns.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có mẫu tin ZNS nào!</p>
            <p>
                Khai lại đúng Template Id + danh sách key tham số của mẫu tin ĐÃ ĐƯỢC ZALO
                DUYỆT (xem trong Zalo Business &gt; Mẫu tin ZNS) - module này không tự đồng bộ.
            </p>
        </field>
    </record>

    <menuitem id="zalo_menu_template" name="Mẫu tin" parent="zalo_menu_root"
              action="zalo_zns_template_action" sequence="10"/>
</odoo>
