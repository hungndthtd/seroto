<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zalo_sale_order_cancel_wizard_view_form" model="ir.ui.view">
        <field name="name">zalo.sale.order.cancel.wizard.form</field>
        <field name="model">zalo.sale.order.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Hủy đơn hàng">
                <p class="text-muted">
                    Đơn hàng <field name="sale_order_id" readonly="1" class="oe_inline"/> sẽ được
                    hủy và tự động gửi ZNS theo mẫu <field name="template_id" readonly="1" class="oe_inline"/>.
                </p>
                <group>
                    <field name="cancel_reason" placeholder="VD: Khách đổi ý, không còn nhu cầu..."/>
                </group>
                <footer>
                    <button string="Xác nhận hủy" type="object" name="action_confirm_cancel"
                            class="btn-primary"/>
                    <button string="Đóng" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
