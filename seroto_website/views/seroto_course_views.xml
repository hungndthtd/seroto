<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Thêm nút "Tạo trang landing" vào form Khóa học (seroto.course, định nghĩa gốc ở
    module seroto_form) - kế thừa view thay vì sửa trực tiếp view gốc, vì action
    action_create_landing_page() chỉ tồn tại khi module seroto_website được cài
    (xem models/seroto_course.py trong module này) - seroto_form không được phép biết
    tới action này (sẽ tạo phụ thuộc vòng tròn ngược lại module con).
  -->
  <record id="view_seroto_course_form_inherit_website" model="ir.ui.view">
    <field name="name">seroto.course.form.inherit.website</field>
    <field name="model">seroto.course</field>
    <field name="inherit_id" ref="seroto_form.view_seroto_course_form"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='action_view_classes'][1]" position="after">
        <button
          name="action_create_landing_page"
          type="object"
          string="Tạo trang landing"
          invisible="landing_page_url"
        />
      </xpath>
    </field>
  </record>
</odoo>
