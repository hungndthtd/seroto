<?xml version="1.0" encoding="utf-8"?>

<odoo>
  <template id="s_trai_nghiem_eq_timeline" name="Lịch trình học">
    <section class="s_trai_nghiem_eq_timeline custom-snippet pt48 pb48">
      <div class="container-page">
        <h2 class="text-center text-green fw-bold">
          Lịch trình học
        </h2>
        <div class="mb-5 mx-auto" style="width: 80px; height: 2px; background: var(--color-yellow); border-radius: 2px;"></div>
        <div class="row text-center">
          <div class="col-12 col-sm-6 col-lg-4 mb-4">
            <div class="timeline__step" style="background: linear-gradient(rgb(221, 243, 255), rgb(255, 255, 255)); border-color: #c9ecff;">
              <div class="timeline__step-image">
                <img src="/web/static/img/placeholder.png" alt="[TÊN KHÓA HỌC]"
                  class="img-fluid" style="max-height: 80px;"/>
              </div>
              <div class="timeline__step-content">
                <h4 class="fw-bold">Chủ đề 1</h4>
                <p class="text-lg mb-2">Bạo lực học đường</p>
                <div class="text-2xl fw-bold text-green">02 &amp; 03/08</div>
              </div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-lg-4 mb-4">
            <div class="timeline__step" style="background: linear-gradient(rgb(255, 251, 229), rgb(255, 255, 255)); border-color: #ffee9e;">
              <div class="timeline__step-image">
                <img src="/web/static/img/placeholder.png" alt="[TÊN KHÓA HỌC]"
                  class="img-fluid" style="max-height: 80px;"/>
              </div>
              <div class="timeline__step-content">
                <h4 class="fw-bold">Chủ đề 2</h4>
                <p class="text-lg mb-2">Xây dựng lớp học hoà hợp</p>
                <div class="text-2xl fw-bold text-green">09 &amp; 10/08</div>
              </div>
            </div>
          </div>
          <div class="col-12 col-sm-6 col-lg-4 mb-4">
            <div class="timeline__step" style="background: linear-gradient(rgb(236, 255, 245), rgb(255, 255, 255)); border-color: #b6e09e;">
              <div class="timeline__step-image">
                <img src="/web/static/img/placeholder.png" alt="[TÊN KHÓA HỌC]"
                  class="img-fluid" style="max-height: 80px;"/>
              </div>
              <div class="timeline__step-content">
                <h4 class="fw-bold">Chủ đề 3</h4>
                <p class="text-lg mb-2">Kỹ năng tự học</p>
                <div class="text-2xl fw-bold text-green">16 &amp; 17/08</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </template>
</odoo>