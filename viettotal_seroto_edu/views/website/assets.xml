<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════
         Static Assets Bundle
    ══════════════════════════════════════════════════════════════════ -->
    <template id="assets_website" name="Seroto Edu – Website Assets">
        <link rel="stylesheet"
              href="/viettotal_seroto_edu/static/src/css/website_registration.css"/>
        <script type="text/javascript"
                src="/viettotal_seroto_edu/static/src/js/website_registration.js"/>
    </template>

    <!-- ══════════════════════════════════════════════════════════════
         Thêm menu "Đăng ký học" vào navbar website
         inherit từ website.layout để gắn vào header
    ══════════════════════════════════════════════════════════════════ -->
    <template id="website_nav_link" inherit_id="website.layout"
              name="Seroto Edu – Nav Link">
        <xpath expr="//ul[hasclass('navbar-nav')]" position="inside">
            <li class="nav-item">
                <a href="/dang-ky" class="nav-link se-nav-link">
                    ✏️ Đăng ký học
                </a>
            </li>
        </xpath>
    </template>

    <!-- ══════════════════════════════════════════════════════════════
         Nút CTA nổi (sticky) ở góc phải màn hình
         Chỉ hiện trên các trang không phải trang form
    ══════════════════════════════════════════════════════════════════ -->
    <template id="website_sticky_cta" inherit_id="website.layout"
              name="Seroto Edu – Sticky CTA">
        <xpath expr="//body" position="inside">
            <div id="se-sticky-cta"
                 t-if="not request.httprequest.path.startswith('/dang-ky')"
                 style="
                    position: fixed; bottom: 28px; right: 24px; z-index: 999;
                    display: flex; flex-direction: column; gap: 8px; align-items: flex-end;
                 ">
                <a href="/dang-ky/form"
                   style="
                      background: #F5A623; color: #1A2B4A;
                      padding: 13px 22px; border-radius: 40px;
                      font-weight: 700; font-size: 14px;
                      text-decoration: none; box-shadow: 0 4px 16px rgba(245,166,35,.45);
                      transition: transform .15s;
                      white-space: nowrap;
                   "
                   onmouseover="this.style.transform='translateY(-2px)'"
                   onmouseout="this.style.transform=''">
                    ✏️ Đăng ký học
                </a>
                <a href="/dang-ky/tra-cuu"
                   style="
                      background: #1A2B4A; color: #fff;
                      padding: 10px 18px; border-radius: 40px;
                      font-weight: 600; font-size: 13px;
                      text-decoration: none; box-shadow: 0 4px 12px rgba(26,43,74,.30);
                      white-space: nowrap;
                   ">
                    🔍 Tra cứu hồ sơ
                </a>
            </div>
        </xpath>
    </template>

</odoo>
