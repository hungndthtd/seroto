<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="website_registration_form" name="Seroto Edu – Form đăng ký">
    <t t-call="website.layout">
        <t t-set="additional_title"><t t-out="page_title"/></t>
        <t t-call-assets="viettotal_seroto_edu.assets_website" t-css="True" t-js="False"/>

        <div class="se-page">

            <!-- Hero mini -->
            <div class="se-form-hero">
                <h1>📝 Form đăng ký học</h1>
                <p>Điền đầy đủ thông tin để được tư vấn và sắp xếp lịch học phù hợp nhất</p>
            </div>

            <!-- Form wrap -->
            <div class="se-form-wrap">
                <div class="se-form-card">

                    <!-- ── Errors ──────────────────────────────────── -->
                    <t t-if="errors">
                        <div class="se-alert-error">
                            <strong>⚠️ Vui lòng kiểm tra lại thông tin:</strong>
                            <ul>
                                <t t-foreach="errors" t-as="err">
                                    <li><t t-out="err"/></li>
                                </t>
                            </ul>
                        </div>
                    </t>

                    <!-- ── Step indicators ──────────────────────────── -->
                    <div class="se-steps">
                        <div class="se-step active">
                            <span class="se-step-num">1</span>Khoá học
                        </div>
                        <div class="se-step">
                            <span class="se-step-num">2</span>Thông tin cá nhân
                        </div>
                        <div class="se-step">
                            <span class="se-step-num">3</span>Trình độ &amp; Mục tiêu
                        </div>
                        <div class="se-step">
                            <span class="se-step-num">4</span>Phụ huynh &amp; Ghi chú
                        </div>
                    </div>

                    <form action="/dang-ky/form/submit" method="post"
                          enctype="application/x-www-form-urlencoded"
                          id="se-registration-form" novalidate="novalidate">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="class_id" id="class_id"
                               t-att-value="form_data.get('class_id','')"/>

                        <!-- ══════════════════════════════════════════
                             STEP 1 – Khoá học
                        ══════════════════════════════════════════ -->
                        <div class="se-form-section active">
                            <div class="se-form-section-title">🎯 Khoá học quan tâm</div>

                            <div class="se-field-group">
                                <label for="course_id">
                                    Chọn khoá học <span class="required">*</span>
                                </label>
                                <select name="course_id" id="course_id" required="required">
                                    <option value="">-- Chọn khoá học --</option>
                                    <t t-foreach="courses" t-as="course">
                                        <option t-att-value="course.id"
                                                t-att-selected="str(form_data.get('course_id','')) == str(course.id) or (selected_course and selected_course.id == course.id)">
                                            <t t-out="course.name"/>
                                            <t t-if="course.tuition_fee">
                                                – <t t-out="'{:,.0f}'.format(course.tuition_fee)"/>đ
                                            </t>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!-- Lịch học: load bằng AJAX -->
                            <div class="se-field-group">
                                <label>Chọn lịch học</label>
                                <div id="se-class-container">
                                    <t t-if="classes">
                                        <div class="se-class-options">
                                            <t t-foreach="classes" t-as="cls">
                                                <div class="se-class-card"
                                                     t-att-onclick="'selectClass(this,' + str(cls.id) + ')'">
                                                    <input type="radio" name="_class_radio"
                                                           t-att-value="cls.id"
                                                           t-att-checked="cls_index == 0 or str(form_data.get('class_id','')) == str(cls.id)"/>
                                                    <t t-set="seats" t-value="cls.available_seats"/>
                                                    <span t-attf-class="se-class-badge #{seats &lt;= 3 and 'few' or ''}">
                                                        <t t-if="seats &lt;= 3">Sắp đầy</t>
                                                        <t t-else="">Còn chỗ</t>
                                                        (<t t-out="seats"/>)
                                                    </span>
                                                    <div class="se-class-name"><t t-out="cls.name"/></div>
                                                    <div class="se-class-detail">
                                                        <t t-if="cls.date_start">
                                                            📅 Khai giảng: <t t-out="cls.date_start.strftime('%d/%m/%Y')"/>
                                                        </t>
                                                        <t t-if="cls.schedule_note">
                                                            &amp;nbsp;·&amp;nbsp; 🕐 <t t-out="cls.schedule_note"/>
                                                        </t>
                                                        <t t-if="cls.teacher_id">
                                                            &amp;nbsp;·&amp;nbsp; 👩‍🏫 <t t-out="cls.teacher_id.name"/>
                                                        </t>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-if="not classes and not selected_course">
                                        <p class="se-hint">Vui lòng chọn khoá học để xem lịch học.</p>
                                    </t>
                                </div>
                                <p class="se-hint">Nếu không có lịch phù hợp, tư vấn viên sẽ liên hệ sắp xếp.</p>
                            </div>

                            <!-- Kênh biết đến -->
                            <div class="se-field-group">
                                <label>Bạn biết đến chúng tôi qua đâu?</label>
                                <div class="se-radio-group">
                                    <t t-foreach="admission_channels" t-as="ch">
                                        <div class="se-radio-item">
                                            <input type="radio" name="admission_channel"
                                                   t-att-id="'ch_' + ch[0]"
                                                   t-att-value="ch[0]"
                                                   t-att-checked="form_data.get('admission_channel') == ch[0]"/>
                                            <label t-att-for="'ch_' + ch[0]">
                                                <t t-out="ch[1]"/>
                                            </label>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <div class="se-field-group" id="referred_by_field">
                                <label for="referred_by">Tên người giới thiệu (nếu có)</label>
                                <input type="text" name="referred_by" id="referred_by"
                                       placeholder="Họ tên / mã học viên người giới thiệu"
                                       t-att-value="form_data.get('referred_by','')"/>
                            </div>
                        </div>

                        <!-- ══════════════════════════════════════════
                             STEP 2 – Thông tin cá nhân
                        ══════════════════════════════════════════ -->
                        <div class="se-form-section">
                            <div class="se-form-section-title">👤 Thông tin học viên</div>

                            <div class="se-row se-row-2">
                                <div class="se-field-group">
                                    <label for="student_name">
                                        Họ và tên <span class="required">*</span>
                                    </label>
                                    <input type="text" name="student_name" id="student_name"
                                           required="required" placeholder="Nguyễn Văn A"
                                           t-att-value="form_data.get('student_name','')"/>
                                </div>
                                <div class="se-field-group">
                                    <label for="date_of_birth">Ngày sinh</label>
                                    <input type="date" name="date_of_birth" id="date_of_birth"
                                           t-att-value="form_data.get('date_of_birth','')"/>
                                </div>
                            </div>

                            <div class="se-field-group">
                                <label>Giới tính</label>
                                <div class="se-radio-group">
                                    <div class="se-radio-item">
                                        <input type="radio" name="gender" id="g_male" value="male"
                                               t-att-checked="form_data.get('gender','male') == 'male'"/>
                                        <label for="g_male">Nam</label>
                                    </div>
                                    <div class="se-radio-item">
                                        <input type="radio" name="gender" id="g_female" value="female"
                                               t-att-checked="form_data.get('gender') == 'female'"/>
                                        <label for="g_female">Nữ</label>
                                    </div>
                                    <div class="se-radio-item">
                                        <input type="radio" name="gender" id="g_other" value="other"
                                               t-att-checked="form_data.get('gender') == 'other'"/>
                                        <label for="g_other">Khác</label>
                                    </div>
                                </div>
                            </div>

                            <div class="se-row se-row-2">
                                <div class="se-field-group">
                                    <label for="phone">
                                        Số điện thoại <span class="required">*</span>
                                    </label>
                                    <input type="tel" name="phone" id="phone"
                                           required="required" placeholder="0901 234 567"
                                           t-att-value="form_data.get('phone','')"/>
                                </div>
                                <div class="se-field-group">
                                    <label for="email">Email</label>
                                    <input type="email" name="email" id="email"
                                           placeholder="email@example.com"
                                           t-att-value="form_data.get('email','')"/>
                                </div>
                            </div>

                            <div class="se-row se-row-2">
                                <div class="se-field-group">
                                    <label for="id_number">CMND / CCCD</label>
                                    <input type="text" name="id_number" id="id_number"
                                           placeholder="012345678901"
                                           t-att-value="form_data.get('id_number','')"/>
                                </div>
                                <div class="se-field-group">
                                    <label for="education_level">Trình độ học vấn</label>
                                    <select name="education_level" id="education_level">
                                        <option value="">-- Chọn --</option>
                                        <t t-foreach="education_levels" t-as="lvl">
                                            <option t-att-value="lvl[0]"
                                                    t-att-selected="form_data.get('education_level') == lvl[0]">
                                                <t t-out="lvl[1]"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>

                            <div class="se-row se-row-2">
                                <div class="se-field-group">
                                    <label for="current_job">Nghề nghiệp</label>
                                    <input type="text" name="current_job" id="current_job"
                                           placeholder="VD: Sinh viên, Kỹ sư, Giáo viên…"
                                           t-att-value="form_data.get('current_job','')"/>
                                </div>
                                <div class="se-field-group">
                                    <label for="workplace">Nơi làm việc / Trường học</label>
                                    <input type="text" name="workplace" id="workplace"
                                           placeholder="Tên công ty / trường"
                                           t-att-value="form_data.get('workplace','')"/>
                                </div>
                            </div>

                            <div class="se-field-group">
                                <label for="address">Địa chỉ thường trú</label>
                                <input type="text" name="address" id="address"
                                       placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố"
                                       t-att-value="form_data.get('address','')"/>
                            </div>

                            <div class="se-field-group">
                                <label for="current_address">Địa chỉ hiện tại <small class="se-hint">(nếu khác thường trú)</small></label>
                                <input type="text" name="current_address" id="current_address"
                                       placeholder="Địa chỉ đang sinh sống / làm việc"
                                       t-att-value="form_data.get('current_address','')"/>
                            </div>
                        </div>

                        <!-- ══════════════════════════════════════════
                             STEP 3 – Trình độ & Mục tiêu
                        ══════════════════════════════════════════ -->
                        <div class="se-form-section">
                            <div class="se-form-section-title">📊 Trình độ &amp; Mục tiêu học tập</div>

                            <div class="se-field-group">
                                <label>Trình độ tiếng Anh hiện tại <span class="required">*</span></label>
                                <div class="se-class-options">
                                    <t t-foreach="english_levels" t-as="lvl">
                                        <div class="se-class-card"
                                             t-att-onclick="'this.querySelector(&quot;input&quot;).checked=true'">
                                            <input type="radio" name="english_level"
                                                   t-att-value="lvl[0]"
                                                   t-att-checked="form_data.get('english_level') == lvl[0] or (not form_data.get('english_level') and lvl_index == 0)"/>
                                            <div class="se-class-name"><t t-out="lvl[1]"/></div>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <div class="se-row se-row-2">
                                <div class="se-field-group">
                                    <label for="target_cert">Chứng chỉ mục tiêu</label>
                                    <input type="text" name="target_cert" id="target_cert"
                                           placeholder="VD: IELTS, TOEIC, Cambridge…"
                                           t-att-value="form_data.get('target_cert','')"/>
                                </div>
                                <div class="se-field-group">
                                    <label for="target_score">Điểm / Band mục tiêu</label>
                                    <input type="text" name="target_score" id="target_score"
                                           placeholder="VD: 6.5, 750, C1…"
                                           t-att-value="form_data.get('target_score','')"/>
                                </div>
                            </div>

                            <div class="se-field-group">
                                <label for="learning_goal">Mục tiêu học tập chi tiết</label>
                                <textarea name="learning_goal" id="learning_goal"
                                          maxlength="500"
                                          placeholder="Bạn muốn đạt được gì sau khoá học? Dùng tiếng Anh cho mục đích gì?&#10;VD: Phỏng vấn công ty nước ngoài, du học, thăng tiến công việc…">
                                    <t t-out="form_data.get('learning_goal','')"/>
                                </textarea>
                            </div>

                            <div class="se-field-group">
                                <label for="available_time">Thời gian bạn có thể học</label>
                                <input type="text" name="available_time" id="available_time"
                                       placeholder="VD: Tối T2-T4-T6, Cuối tuần sáng…"
                                       t-att-value="form_data.get('available_time','')"/>
                                <p class="se-hint">Giúp tư vấn viên sắp xếp lịch học phù hợp nhất cho bạn</p>
                            </div>
                        </div>

                        <!-- ══════════════════════════════════════════
                             STEP 4 – Phụ huynh & Ghi chú
                        ══════════════════════════════════════════ -->
                        <div class="se-form-section">
                            <div class="se-form-section-title">👨‍👩‍👧 Phụ huynh &amp; Thông tin thêm</div>

                            <!-- Toggle phụ huynh -->
                            <div class="se-field-group" style="margin-bottom:8px;">
                                <label style="display:flex; align-items:center; gap:10px; cursor:pointer; font-weight:600;">
                                    <input type="checkbox" id="se-toggle-parent" style="width:18px; height:18px;"/>
                                    Cung cấp thông tin phụ huynh / người bảo lãnh
                                </label>
                                <p class="se-hint">Bắt buộc với học viên dưới 18 tuổi hoặc người bảo lãnh thanh toán</p>
                            </div>

                            <div id="se-parent-section" style="display:none; padding:20px; background:var(--se-bg); border-radius:8px; margin-bottom:20px;">
                                <div class="se-row se-row-2">
                                    <div class="se-field-group">
                                        <label for="parent_name">Họ tên phụ huynh / bảo lãnh</label>
                                        <input type="text" name="parent_name" id="parent_name"
                                               placeholder="Nguyễn Văn B"
                                               t-att-value="form_data.get('parent_name','')"/>
                                    </div>
                                    <div class="se-field-group">
                                        <label for="parent_phone">Số điện thoại phụ huynh</label>
                                        <input type="tel" name="parent_phone" id="parent_phone"
                                               placeholder="0901 234 567"
                                               t-att-value="form_data.get('parent_phone','')"/>
                                    </div>
                                </div>
                                <div class="se-field-group">
                                    <label for="parent_relationship">Quan hệ với học viên</label>
                                    <select name="parent_relationship" id="parent_relationship">
                                        <option value="">-- Chọn quan hệ --</option>
                                        <t t-foreach="parent_relationships" t-as="rel">
                                            <option t-att-value="rel[0]"
                                                    t-att-selected="form_data.get('parent_relationship') == rel[0]">
                                                <t t-out="rel[1]"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>

                            <!-- Ghi chú -->
                            <div class="se-field-group">
                                <label for="note">Yêu cầu / Ghi chú thêm</label>
                                <textarea name="note" id="note" maxlength="300"
                                          placeholder="Câu hỏi, yêu cầu đặc biệt hoặc bất kỳ thông tin nào bạn muốn chúng tôi biết…">
                                    <t t-out="form_data.get('note','')"/>
                                </textarea>
                            </div>

                            <!-- Xác nhận -->
                            <div class="se-field-group">
                                <label style="display:flex; align-items:flex-start; gap:10px; cursor:pointer; font-weight:400;">
                                    <input type="checkbox" name="agree_terms" required="required"
                                           style="width:18px; height:18px; margin-top:2px; flex-shrink:0;"/>
                                    <span>
                                        Tôi đồng ý cho Seroto Education sử dụng thông tin trên để
                                        liên hệ tư vấn và ghi nhận hồ sơ đăng ký.
                                        <span class="required">*</span>
                                    </span>
                                </label>
                            </div>

                            <!-- Submit -->
                            <div style="background:var(--se-bg); border-radius:8px; padding:20px; margin-top:8px;">
                                <div class="d-flex gap-3 align-items-center flex-wrap">
                                    <button type="submit" class="se-btn se-btn-primary" style="font-size:17px; padding:16px 36px;">
                                        ✅ Gửi đăng ký
                                    </button>
                                    <span style="color:var(--se-muted); font-size:13px;">
                                        🔒 Thông tin được bảo mật tuyệt đối
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- ── Form navigation ──────────────────────── -->
                        <div class="se-form-nav">
                            <button type="button" class="se-btn se-btn-outline se-btn-prev"
                                    style="background:transparent; color:var(--se-navy); border:1.5px solid var(--se-border);">
                                ← Quay lại
                            </button>
                            <div class="se-form-nav-right">
                                <button type="button" class="se-btn se-btn-navy se-btn-next">
                                    Tiếp theo →
                                </button>
                            </div>
                        </div>

                    </form>
                </div>

                <!-- Liên hệ trực tiếp -->
                <div style="text-align:center; padding:24px 0; color:var(--se-muted); font-size:14px;">
                    Hoặc liên hệ trực tiếp:
                    <strong style="color:var(--se-navy);">
                        <a href="tel:1800xxxx" style="color:var(--se-navy);">📞 1800 xxxx</a>
                        &amp;nbsp;·&amp;nbsp;
                        <a href="https://zalo.me/xxxx" target="_blank" style="color:var(--se-navy);">💬 Zalo</a>
                    </strong>
                </div>
            </div>

        </div>

        <t t-call-assets="viettotal_seroto_edu.assets_website" t-css="False" t-js="True"/>
    </t>
</template>
</odoo>
