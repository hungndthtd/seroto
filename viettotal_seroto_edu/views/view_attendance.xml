<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         edu.attendance  –  Điểm danh
    ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_attendance_list" model="ir.ui.view">
        <field name="name">edu.attendance.list</field>
        <field name="model">edu.attendance</field>
        <field name="arch" type="xml">
            <list string="Điểm danh"
                  decoration-success="status=='present'"
                  decoration-warning="status in ('late','early_leave','online')"
                  decoration-danger="status=='absent'"
                  decoration-muted="status=='absent_leave'">
                <field name="date_session"/>
                <field name="class_id"/>
                <field name="session_id"/>
                <field name="student_id"/>
                <field name="status" widget="badge"
                       decoration-success="status=='present'"
                       decoration-warning="status in ('late','online','early_leave')"
                       decoration-danger="status in ('absent','absent_leave')"/>
                <field name="check_in_time" widget="float_time" optional="show"/>
                <field name="minutes_late" optional="show"/>
                <field name="is_counted_present" readonly="1"/>
                <field name="notified_parent"/>
                <field name="note" optional="show"/>
                <field name="recorded_by" widget="many2one_avatar_user" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_edu_attendance_form" model="ir.ui.view">
        <field name="name">edu.attendance.form</field>
        <field name="model">edu.attendance</field>
        <field name="arch" type="xml">
            <form string="Điểm danh">
                <sheet>
                    <group>
                        <group string="Buổi học">
                            <field name="session_id"/>
                            <field name="class_id" readonly="1"/>
                            <field name="date_session" readonly="1"/>
                        </group>
                        <group string="Học viên">
                            <field name="student_id"/>
                            <field name="status"/>
                            <field name="is_counted_present" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Thời gian thực tế">
                            <field name="check_in_time" widget="float_time"/>
                            <field name="check_out_time" widget="float_time"/>
                            <field name="minutes_late"/>
                        </group>
                        <group string="Thông báo">
                            <field name="notified_parent"/>
                            <field name="notified_at" invisible="not notified_parent"/>
                        </group>
                    </group>
                    <group>
                        <field name="leave_reason" placeholder="Lý do nghỉ phép…"
                               invisible="status not in ('absent_leave',)"/>
                        <field name="note" placeholder="Ghi chú…"/>
                        <field name="recorded_by" readonly="1"/>
                        <field name="record_date" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edu_attendance_search" model="ir.ui.view">
        <field name="name">edu.attendance.search</field>
        <field name="model">edu.attendance</field>
        <field name="arch" type="xml">
            <search string="Tìm điểm danh">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="session_id"/>
                <separator/>
                <filter name="present" string="Có mặt" domain="[('status','=','present')]"/>
                <filter name="absent" string="Vắng không phép" domain="[('status','=','absent')]"/>
                <filter name="late" string="Đi trễ" domain="[('status','=','late')]"/>
                <filter name="not_notified" string="Chưa báo phụ huynh"
                        domain="[('notified_parent','=',False),('status','in',['absent','absent_leave'])]"/>
                <filter name="today" string="Hôm nay"
                        domain="[('date_session','=',context_today().strftime('%Y-%m-%d'))]"/>
                <group >
                    <filter name="group_class" string="Lớp học" context="{'group_by':'class_id'}"/>
                    <filter name="group_student" string="Học viên" context="{'group_by':'student_id'}"/>
                    <filter name="group_status" string="Trạng thái" context="{'group_by':'status'}"/>
                    <filter name="group_date" string="Ngày" context="{'group_by':'date_session'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_attendance" model="ir.actions.act_window">
        <field name="name">Điểm danh</field>
        <field name="res_model">edu.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_attendance_search"/>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         edu.attendance.wizard  –  Điểm danh hàng loạt
    ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_attendance_wizard_form" model="ir.ui.view">
        <field name="name">edu.attendance.wizard.form</field>
        <field name="model">edu.attendance.wizard</field>
        <field name="arch" type="xml">
            <form string="Điểm danh buổi học">
                <sheet>
                    <group>
                        <field name="session_id"/>
                        <field name="class_id" readonly="1"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="student_id" readonly="1"/>
                            <field name="status" widget="badge"
                                   decoration-success="status=='present'"
                                   decoration-warning="status in ('late','online')"
                                   decoration-danger="status in ('absent','absent_leave')"/>
                            <field name="note"/>
                        </list>
                    </field>
                    <footer>
                        <button name="action_confirm" string="Xác nhận điểm danh"
                                type="object" class="oe_highlight"/>
                        <button string="Huỷ" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_edu_attendance_wizard" model="ir.actions.act_window">
        <field name="name">Điểm danh buổi học</field>
        <field name="res_model">edu.attendance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         edu.learning.progress  –  Tiến độ học tập
    ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_learning_progress_list" model="ir.ui.view">
        <field name="name">edu.learning.progress.list</field>
        <field name="model">edu.learning.progress</field>
        <field name="arch" type="xml">
            <list string="Tiến độ học tập"
                  decoration-danger="needs_attention==True"
                  decoration-warning="attendance_rate &lt; 70">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="sessions_total"/>
                <field name="sessions_attended"/>
                <field name="attendance_rate" widget="progressbar"/>
                <field name="progress_percent" widget="progressbar"/>
                <field name="average_score"/>
                <field name="latest_score"/>
                <field name="needs_attention" widget="boolean_toggle"/>
                <field name="last_update"/>
            </list>
        </field>
    </record>

    <record id="view_edu_learning_progress_form" model="ir.ui.view">
        <field name="name">edu.learning.progress.form</field>
        <field name="model">edu.learning.progress</field>
        <field name="arch" type="xml">
            <form string="Tiến độ học tập">
                <sheet>
                    <widget name="web_ribbon" title="Cần chú ý" bg_color="bg-danger"
                            invisible="not needs_attention"/>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="class_id"/>
                            <field name="enrollment_id"/>
                        </group>
                        <group string="Chuyên cần">
                            <field name="sessions_total"/>
                            <field name="sessions_attended"/>
                            <field name="attendance_rate" widget="progressbar"/>
                            <field name="progress_percent" widget="progressbar"/>
                        </group>
                    </group>
                    <group>
                        <group string="Kết quả học tập">
                            <field name="average_score"/>
                            <field name="latest_score"/>
                            <field name="last_update"/>
                        </group>
                        <group string="Cờ chú ý">
                            <field name="needs_attention" widget="boolean_toggle"/>
                            <field name="attention_note" placeholder="Lý do cần chú ý đặc biệt…"
                                   invisible="not needs_attention"/>
                        </group>
                    </group>
                    <group string="Nhận xét giáo viên">
                        <field name="teacher_comment" nolabel="1"
                               placeholder="Nhận xét và đánh giá của giáo viên về học viên…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edu_learning_progress_search" model="ir.ui.view">
        <field name="name">edu.learning.progress.search</field>
        <field name="model">edu.learning.progress</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="class_id"/>
                <separator/>
                <filter name="needs_attention" string="Cần chú ý"
                        domain="[('needs_attention','=',True)]"/>
                <filter name="low_attendance" string="Chuyên cần thấp (&lt;70%)"
                        domain="[('attendance_rate','&lt;',70)]"/>
                <group >
                    <filter name="group_class" string="Lớp học" context="{'group_by':'class_id'}"/>
                    <filter name="group_student" string="Học viên" context="{'group_by':'student_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_learning_progress" model="ir.actions.act_window">
        <field name="name">Tiến độ học tập</field>
        <field name="res_model">edu.learning.progress</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_learning_progress_search"/>
    </record>

</odoo>
