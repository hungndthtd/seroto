<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         edu.course  –  Khoá học
    ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_course_form" model="ir.ui.view">
        <field name="name">edu.course.form</field>
        <field name="model">edu.course</field>
        <field name="arch" type="xml">
            <form string="Khoá học">
                <header>
                    <button name="action_publish" type="object"
                            string="Mở đăng ký" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_close" type="object"
                            string="Đóng đăng ký"
                            invisible="state != 'published'"/>
                    <button name="action_view_classes" type="object"
                            string="Xem các lớp"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-users" type="object"
                                name="action_view_classes">
                            <field name="class_count" widget="statinfo" string="Lớp học"/>
                        </button>
                        <button name="action_view_product" type="object"
                                class="oe_stat_button" icon="fa-cube"
                                invisible="not product_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Product</span>
                                <span class="o_stat_value">
                                    <field name="product_id" readonly="1"/>
                                </span>
                            </div>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="code" string="Mã khoá"/>
                        <h3><field name="code" placeholder="VD: IELTS-INT-01"/></h3>
                        <label for="name"/>
                        <h1><field name="name" placeholder="Tên khoá học"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin chung">
                            <field name="category_id"/>
                            <field name="total_sessions"/>
                            <field name="session_duration"/>
                            <field name="total_hours" readonly="1"/>
                            <field name="has_certificate"/>
                            <field name="certificate_type"
                                   invisible="not has_certificate"/>
                        </group>
                        <group string="Học phí &amp; Thuế">
                            <field name="tuition_fee"/>
                            <field name="currency_id"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                            <field name="product_id" readonly="1"
                                   help="Tự động tạo khi lưu khoá học"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mô tả khoá học">
                            <field name="description" placeholder="Mô tả chi tiết khoá học…"/>
                        </page>
                        <page string="Nội dung &amp; Yêu cầu">
                            <group>
                                <field name="target_audience" placeholder="Đối tượng học viên phù hợp…"/>
                                <field name="objectives" placeholder="Học viên sẽ đạt được gì sau khoá học…"/>
                                <field name="prerequisites" placeholder="Yêu cầu đầu vào…"/>
                            </group>
                        </page>
                        <page string="Lớp học">
                            <field name="class_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="teacher_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="enrolled_count"/>
                                    <field name="max_students"/>
                                    <field name="available_seats"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state=='ongoing'"
                                           decoration-info="state=='scheduled'"
                                           decoration-muted="state=='completed'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_edu_course_list" model="ir.ui.view">
        <field name="name">edu.course.list</field>
        <field name="model">edu.course</field>
        <field name="arch" type="xml">
            <list string="Khoá học">
                <field name="image" widget="image" optional="show" width="38"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="total_sessions"/>
                <field name="total_hours"/>
                <field name="tuition_fee" widget="monetary" options="{'currency_field':'currency_id'}"/>
                <field name="class_count"/>
                <field name="has_certificate"/>
                <field name="state" widget="badge"
                       decoration-success="state=='published'"
                       decoration-muted="state in ('draft','closed','archived')"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_edu_course_kanban" model="ir.ui.view">
        <field name="name">edu.course.kanban</field>
        <field name="model">edu.course</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="image"/>
                <field name="name"/>
                <field name="code"/>
                <field name="class_count"/>
                <field name="tuition_fee"/>
                <field name="currency_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <field name="image" widget="image" class="o_image_64_cover mb-2"/>
                            <strong><field name="name"/></strong>
                            <div class="text-muted small"><field name="code"/></div>
                            <div class="d-flex justify-content-between mt-1">
                                <span><field name="class_count"/> lớp</span>
                                <field name="tuition_fee" widget="monetary"
                                       options="{'currency_field':'currency_id'}"/>
                            </div>
                            <field name="state" widget="badge"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_edu_course_search" model="ir.ui.view">
        <field name="name">edu.course.search</field>
        <field name="model">edu.course</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <filter name="published" string="Đang mở đăng ký" domain="[('state','=','published')]"/>
                <filter name="has_cert" string="Có chứng chỉ" domain="[('has_certificate','=',True)]"/>
                <group >
                    <filter name="group_category" string="Danh mục" context="{'group_by':'category_id'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_course" model="ir.actions.act_window">
        <field name="name">Khoá học</field>
        <field name="res_model">edu.course</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_edu_course_search"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         edu.course.class  –  Lớp học
    ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_course_class_form" model="ir.ui.view">
        <field name="name">edu.course.class.form</field>
        <field name="model">edu.course.class</field>
        <field name="arch" type="xml">
            <form string="Lớp học">
                <header>
                    <button name="action_start_class" string="Bắt đầu khai giảng"
                            type="object" class="oe_highlight"
                            invisible="state != 'scheduled'"/>
                    <button name="action_complete_class" string="Kết thúc lớp"
                            type="object"
                            invisible="state != 'ongoing'"
                            confirm="Xác nhận kết thúc lớp học này?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="scheduled,ongoing,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-users">
                            <field name="enrolled_count" widget="statinfo" string="Học viên"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-calendar">
                            <field name="session_count" widget="statinfo" string="Buổi học"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="code"/>
                        <h3><field name="code" placeholder="Mã lớp"/></h3>
                        <label for="name"/>
                        <h1><field name="name" placeholder="Tên lớp học"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin lớp">
                            <field name="course_id"/>
                            <field name="teacher_id"/>
                            <field name="room_id"/>
                            <field name="schedule_note" placeholder="VD: T2-T4-T6, 18:00-20:00"/>
                        </group>
                        <group string="Thời gian &amp; Sĩ số">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="max_students"/>
                            <field name="enrolled_count" readonly="1"/>
                            <field name="available_seats" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Danh sách học viên">
                            <field name="enrollment_ids">
                                <list>
                                    <field name="student_id"/>
                                    <field name="date_enrolled"/>
                                    <field name="date_start"/>
                                    <field name="tuition_fee" widget="monetary"
                                           options="{'currency_field':'currency_id'}"/>
                                    <field name="amount_paid" widget="monetary"
                                           options="{'currency_field':'currency_id'}"/>
                                    <field name="payment_status" widget="badge"
                                           decoration-success="payment_status=='paid'"
                                           decoration-warning="payment_status=='partial'"
                                           decoration-danger="payment_status=='unpaid'"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state=='completed'"
                                           decoration-info="state=='studying'"
                                           decoration-warning="state=='on_leave'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lịch buổi học">
                            <field name="session_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="date_session"/>
                                    <field name="time_start" widget="float_time"/>
                                    <field name="time_end" widget="float_time"/>
                                    <field name="duration" widget="float_time" readonly="1"/>
                                    <field name="topic"/>
                                    <field name="room_id"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state=='completed'"
                                           decoration-warning="state in ('cancelled','postponed')"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_edu_course_class_list" model="ir.ui.view">
        <field name="name">edu.course.class.list</field>
        <field name="model">edu.course.class</field>
        <field name="arch" type="xml">
            <list string="Lớp học"
                  decoration-success="state=='ongoing'"
                  decoration-muted="state in ('completed','cancelled')">
                <field name="code"/>
                <field name="name"/>
                <field name="course_id"/>
                <field name="teacher_id" widget="many2one_avatar"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="schedule_note"/>
                <field name="enrolled_count"/>
                <field name="max_students"/>
                <field name="available_seats"/>
                <field name="state" widget="badge"
                       decoration-success="state=='ongoing'"
                       decoration-info="state=='scheduled'"
                       decoration-muted="state=='completed'"/>
            </list>
        </field>
    </record>

    <record id="view_edu_course_class_search" model="ir.ui.view">
        <field name="name">edu.course.class.search</field>
        <field name="model">edu.course.class</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="course_id"/>
                <field name="teacher_id"/>
                <separator/>
                <filter name="ongoing" string="Đang học" domain="[('state','=','ongoing')]"/>
                <filter name="scheduled" string="Chờ khai giảng" domain="[('state','=','scheduled')]"/>
                <filter name="has_seats" string="Còn chỗ" domain="[('available_seats','>',0)]"/>
                <group >
                    <filter name="group_course" string="Khoá học" context="{'group_by':'course_id'}"/>
                    <filter name="group_teacher" string="Giáo viên" context="{'group_by':'teacher_id'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_course_class" model="ir.actions.act_window">
        <field name="name">Lớp học</field>
        <field name="res_model">edu.course.class</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_course_class_search"/>
        <field name="context">{'search_default_ongoing': 1}</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         edu.session  –  Buổi học (standalone view)
    ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_session_list" model="ir.ui.view">
        <field name="name">edu.session.list</field>
        <field name="model">edu.session</field>
        <field name="arch" type="xml">
            <list string="Buổi học"
                  decoration-success="state=='completed'"
                  decoration-warning="state in ('cancelled','postponed')">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="class_id"/>
                <field name="date_session"/>
                <field name="time_start" widget="float_time"/>
                <field name="time_end" widget="float_time"/>
                <field name="duration" widget="float_time" readonly="1"/>
                <field name="topic"/>
                <field name="teacher_id"/>
                <field name="room_id"/>
                <field name="state" widget="badge"
                       decoration-success="state=='completed'"
                       decoration-warning="state in ('cancelled','postponed')"
                       decoration-info="state=='planned'"/>
            </list>
        </field>
    </record>

    <record id="view_edu_session_form" model="ir.ui.view">
        <field name="name">edu.session.form</field>
        <field name="model">edu.session</field>
        <field name="arch" type="xml">
            <form string="Buổi học">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planned,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="class_id"/>
                            <field name="teacher_id" readonly="1"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="date_session"/>
                            <field name="time_start" widget="float_time"/>
                            <field name="time_end" widget="float_time"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                            <field name="room_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="topic" placeholder="Chủ đề buổi học…"/>
                        <field name="description" placeholder="Mô tả chi tiết…"/>
                        <field name="homework" placeholder="Bài tập về nhà…"/>
                        <field name="cancel_reason" invisible="state not in ('cancelled','postponed')"
                               placeholder="Lý do huỷ / dời lịch…"/>
                    </group>
                    <notebook>
                        <page string="Điểm danh">
                            <field name="attendance_ids">
                                <list editable="bottom">
                                    <field name="student_id"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status=='present'"
                                           decoration-warning="status in ('late','early_leave','online')"
                                           decoration-danger="status in ('absent','absent_leave')"/>
                                    <field name="check_in_time" widget="float_time"/>
                                    <field name="minutes_late"/>
                                    <field name="note"/>
                                    <field name="notified_parent"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_edu_session" model="ir.actions.act_window">
        <field name="name">Buổi học</field>
        <field name="res_model">edu.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         edu.course.category  +  edu.room  (config)
    ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_course_category_list" model="ir.ui.view">
        <field name="name">edu.course.category.list</field>
        <field name="model">edu.course.category</field>
        <field name="arch" type="xml">
            <list string="Danh mục khoá học" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_edu_course_category" model="ir.actions.act_window">
        <field name="name">Danh mục khoá học</field>
        <field name="res_model">edu.course.category</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_edu_room_list" model="ir.ui.view">
        <field name="name">edu.room.list</field>
        <field name="model">edu.room</field>
        <field name="arch" type="xml">
            <list string="Phòng học" editable="bottom">
                <field name="name"/>
                <field name="room_type"/>
                <field name="capacity"/>
                <field name="location"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_edu_room" model="ir.actions.act_window">
        <field name="name">Phòng học</field>
        <field name="res_model">edu.room</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
