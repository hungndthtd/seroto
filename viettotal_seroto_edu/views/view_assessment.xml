<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         edu.exam  –  Bài kiểm tra / Kỳ thi
    ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_exam_form" model="ir.ui.view">
        <field name="name">edu.exam.form</field>
        <field name="model">edu.exam</field>
        <field name="arch" type="xml">
            <form string="Bài kiểm tra">
                <header>
                    <button name="action_generate_results" string="Tạo phiếu điểm cho học viên"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"
                            confirm="Tạo bản ghi kết quả cho tất cả học viên trong lớp?"/>
                    <button name="action_mark_graded" string="Hoàn tất chấm điểm"
                            type="object" class="oe_highlight"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done,graded"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-list-ol">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="result_count"/></span>
                                <span class="o_stat_text">Bài thi</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-check-circle text-success">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="pass_count"/></span>
                                <span class="o_stat_text">Đạt</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-times-circle text-danger">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="fail_count"/></span>
                                <span class="o_stat_text">Không đạt</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Tên bài kiểm tra"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin bài thi">
                            <field name="assessment_type_id"/>
                            <field name="class_id"/>
                            <field name="course_id" readonly="1"/>
                            <field name="teacher_id" readonly="1"/>
                            <field name="session_id"/>
                            <field name="exam_code"/>
                        </group>
                        <group string="Thang điểm &amp; Thời gian">
                            <field name="date_exam"/>
                            <field name="time_start" widget="float_time"/>
                            <field name="duration_minutes"/>
                            <field name="scoring_method"/>
                            <field name="max_score"/>
                            <field name="pass_score"/>
                        </group>
                    </group>
                    <group string="Thống kê kết quả" invisible="state == 'draft'">
                        <group>
                            <field name="average_score" readonly="1"/>
                            <field name="pass_rate" readonly="1" widget="percentage"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kết quả học viên">
                            <field name="result_ids">
                                <list editable="bottom"
                                      decoration-success="is_passed==True"
                                      decoration-danger="is_passed==False and state=='graded'">
                                    <field name="student_id"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state=='graded'"
                                           decoration-muted="state in ('pending','absent')"/>
                                    <field name="score"/>
                                    <field name="score_listening" optional="hide"/>
                                    <field name="score_reading" optional="hide"/>
                                    <field name="score_writing" optional="hide"/>
                                    <field name="score_speaking" optional="hide"/>
                                    <field name="grade" readonly="1"/>
                                    <field name="is_passed" readonly="1"/>
                                    <field name="teacher_feedback" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Mô tả &amp; Hướng dẫn">
                            <group>
                                <field name="description" placeholder="Phạm vi đề thi, yêu cầu…"/>
                            </group>
                            <field name="instructions" placeholder="Hướng dẫn làm bài…"/>
                        </page>
                        <page string="Đề thi đính kèm">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_edu_exam_list" model="ir.ui.view">
        <field name="name">edu.exam.list</field>
        <field name="model">edu.exam</field>
        <field name="arch" type="xml">
            <list string="Bài kiểm tra"
                  decoration-success="state=='graded'"
                  decoration-info="state=='done'"
                  decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="assessment_type_id"/>
                <field name="class_id"/>
                <field name="course_id"/>
                <field name="date_exam"/>
                <field name="scoring_method"/>
                <field name="max_score"/>
                <field name="pass_score"/>
                <field name="result_count"/>
                <field name="pass_count"/>
                <field name="average_score"/>
                <field name="pass_rate" widget="percentage"/>
                <field name="state" widget="badge"
                       decoration-success="state=='graded'"
                       decoration-info="state=='done'"
                       decoration-muted="state=='cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_edu_exam_search" model="ir.ui.view">
        <field name="name">edu.exam.search</field>
        <field name="model">edu.exam</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="class_id"/>
                <field name="course_id"/>
                <field name="assessment_type_id"/>
                <separator/>
                <filter name="draft" string="Chưa thi" domain="[('state','=','draft')]"/>
                <filter name="done" string="Chờ chấm" domain="[('state','=','done')]"/>
                <filter name="graded" string="Đã có điểm" domain="[('state','=','graded')]"/>
                <filter name="upcoming" string="Sắp tới"
                        domain="[('date_exam','&gt;=',context_today().strftime('%Y-%m-%d'))]"/>
                <group >
                    <filter name="group_class" string="Lớp học" context="{'group_by':'class_id'}"/>
                    <filter name="group_type" string="Loại kiểm tra" context="{'group_by':'assessment_type_id'}"/>
                    <filter name="group_month" string="Tháng" context="{'group_by':'date_exam:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_exam" model="ir.actions.act_window">
        <field name="name">Bài kiểm tra</field>
        <field name="res_model">edu.exam</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_exam_search"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         edu.exam.result  –  Kết quả kiểm tra (standalone)
    ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_exam_result_list" model="ir.ui.view">
        <field name="name">edu.exam.result.list</field>
        <field name="model">edu.exam.result</field>
        <field name="arch" type="xml">
            <list string="Kết quả kiểm tra"
                  decoration-success="is_passed==True"
                  decoration-danger="is_passed==False and state=='graded'">
                <field name="exam_id"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="score"/>
                <field name="score_listening" optional="hide"/>
                <field name="score_reading" optional="hide"/>
                <field name="score_writing" optional="hide"/>
                <field name="score_speaking" optional="hide"/>
                <field name="grade" readonly="1"/>
                <field name="is_passed" readonly="1"/>
                <field name="date_graded"/>
                <field name="state" widget="badge"
                       decoration-success="state=='graded'"
                       decoration-muted="state in ('pending','absent')"/>
            </list>
        </field>
    </record>

    <record id="action_edu_exam_result" model="ir.actions.act_window">
        <field name="name">Kết quả kiểm tra</field>
        <field name="res_model">edu.exam.result</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         edu.assessment.type  –  Loại kiểm tra (config)
    ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_assessment_type_list" model="ir.ui.view">
        <field name="name">edu.assessment.type.list</field>
        <field name="model">edu.assessment.type</field>
        <field name="arch" type="xml">
            <list string="Loại kiểm tra" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="weight"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_edu_assessment_type" model="ir.actions.act_window">
        <field name="name">Loại kiểm tra</field>
        <field name="res_model">edu.assessment.type</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
