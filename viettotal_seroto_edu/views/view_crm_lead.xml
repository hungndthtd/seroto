<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         crm.lead – thêm "Khoá học quan tâm" + nút chuyển thành Hồ sơ tuyển sinh
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="crm_lead_view_form_inherit_seroto" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.seroto</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="edu_admission_id" invisible="1"/>
                <button name="action_create_edu_admission" type="object"
                        string="Chuyển thành Hồ sơ tuyển sinh"
                        class="oe_highlight"
                        invisible="edu_admission_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_edu_admission" type="object"
                        class="oe_stat_button" icon="fa-id-card"
                        invisible="not edu_admission_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Hồ sơ tuyển sinh</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@id='phone_group_lead_info']" position="after">
                <field name="course_id"/>
            </xpath>
        </field>
    </record>

</odoo>
