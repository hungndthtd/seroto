<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         edu.teacher  –  Giáo viên / Giảng viên
    ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_teacher_form" model="ir.ui.view">
        <field name="name">edu.teacher.form</field>
        <field name="model">edu.teacher</field>
        <field name="arch" type="xml">
            <form string="Giáo viên">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="probation,official,part_time,resigned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_classes" type="object"
                                class="oe_stat_button" icon="fa-chalkboard-teacher">
                            <field name="class_count" widget="statinfo" string="Lớp học"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="teacher_code"/>
                        <h3><field name="teacher_code" readonly="1"/></h3>
                        <label for="name"/>
                        <h1><field name="name" placeholder="Họ và tên giáo viên"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin cá nhân">
                            <field name="date_of_birth"/>
                            <field name="age" readonly="1"/>
                            <field name="gender"/>
                            <field name="nationality_id"/>
                            <field name="id_number"/>
                            <field name="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group string="Chuyên môn">
                            <field name="specialization"/>
                            <field name="degree"/>
                            <field name="degree_major"/>
                            <field name="years_experience"/>
                        </group>
                    </group>
                    <group>
                        <group string="Nhân sự">
                            <field name="salary_type"/>
                            <field name="salary_rate"/>
                            <field name="currency_id"/>
                            <field name="user_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group string="Địa chỉ">
                            <field name="address" placeholder="Địa chỉ hiện tại"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chứng chỉ / Bằng cấp">
                            <field name="certificate_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="issuer"/>
                                    <field name="issue_date"/>
                                    <field name="expiry_date"/>
                                    <field name="score"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lớp học phụ trách">
                            <field name="class_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="course_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="enrolled_count"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state=='ongoing'"
                                           decoration-info="state=='scheduled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_edu_teacher_list" model="ir.ui.view">
        <field name="name">edu.teacher.list</field>
        <field name="model">edu.teacher</field>
        <field name="arch" type="xml">
            <list string="Giáo viên"
                  decoration-muted="state=='resigned'"
                  decoration-info="state=='part_time'">
                <field name="image" widget="image" optional="show" width="38"/>
                <field name="teacher_code"/>
                <field name="name"/>
                <field name="specialization"/>
                <field name="degree"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="class_count"/>
                <field name="salary_type" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state=='official'"
                       decoration-info="state in ('probation','part_time')"
                       decoration-muted="state=='resigned'"/>
            </list>
        </field>
    </record>

    <record id="view_edu_teacher_kanban" model="ir.ui.view">
        <field name="name">edu.teacher.kanban</field>
        <field name="model">edu.teacher</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="image"/>
                <field name="name"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="class_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click d-flex">
                            <field name="image" widget="image" class="o_image_64_cover me-2"/>
                            <div>
                                <strong><field name="name"/></strong>
                                <div class="text-muted small"><field name="specialization"/></div>
                                <div><field name="phone"/></div>
                                <div class="d-flex justify-content-between mt-1">
                                    <span><field name="class_count"/> lớp</span>
                                    <field name="state" widget="badge"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_edu_teacher_search" model="ir.ui.view">
        <field name="name">edu.teacher.search</field>
        <field name="model">edu.teacher</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="teacher_code"/>
                <field name="specialization"/>
                <separator/>
                <filter name="active_teachers" string="Đang làm việc"
                        domain="[('state','in',('probation','official','part_time'))]"/>
                <filter name="official" string="Chính thức" domain="[('state','=','official')]"/>
                <filter name="part_time" string="Bán thời gian" domain="[('state','=','part_time')]"/>
                <group >
                    <filter name="group_state" string="Trạng thái" context="{'group_by':'state'}"/>
                    <filter name="group_degree" string="Bằng cấp" context="{'group_by':'degree'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_teacher" model="ir.actions.act_window">
        <field name="name">Giáo viên</field>
        <field name="res_model">edu.teacher</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_edu_teacher_search"/>
        <field name="context">{'search_default_active_teachers': 1}</field>
    </record>

</odoo>
