<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         edu.student  –  Học viên
    ══════════════════════════════════════════════════════════════════════════ -->

    <!-- Form -->
    <record id="view_edu_student_form" model="ir.ui.view">
        <field name="name">edu.student.form</field>
        <field name="model">edu.student</field>
        <field name="arch" type="xml">
            <form string="Học viên">
                <header>
                    <button name="action_set_on_leave" string="Bảo lưu"
                            type="object" invisible="state != 'active'"/>
                    <button name="action_set_active" string="Kích hoạt lại"
                            type="object" class="oe_highlight"
                            invisible="state != 'on_leave'"/>
                    <button name="action_set_graduated" string="Tốt nghiệp"
                            type="object" class="oe_highlight"
                            invisible="state not in ('active','on_leave')"/>
                    <button name="action_set_dropped" string="Đánh dấu nghỉ học"
                            type="object"
                            invisible="state in ('graduated','dropped_out')"
                            confirm="Xác nhận học viên nghỉ học?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,on_leave,graduated,dropped_out"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_enrollments" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <field name="enrollment_count" widget="statinfo" string="Đăng ký"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="student_code" string="Mã học viên"/>
                        <h3><field name="student_code" readonly="1"/></h3>
                        <label for="name"/>
                        <h1><field name="name" placeholder="Họ và tên đầy đủ"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin cá nhân">
                            <field name="date_of_birth"/>
                            <field name="age" readonly="1"/>
                            <field name="gender"/>
                            <field name="nationality_id"/>
                            <field name="id_number"/>
                            <field name="id_issue_date"/>
                            <field name="id_issue_place"/>
                        </group>
                        <group string="Liên lạc">
                            <field name="phone"/>
                            <field name="phone_other"/>
                            <field name="email" widget="email"/>
                            <field name="zalo"/>
                            <field name="facebook"/>
                        </group>
                    </group>
                    <group>
                        <group string="Địa chỉ">
                            <field name="address" placeholder="Địa chỉ thường trú"/>
                            <field name="current_address" placeholder="Địa chỉ hiện tại"/>
                            <field name="district"/>
                            <field name="province_id"/>
                        </group>
                        <group string="Học vấn &amp; Nghề nghiệp">
                            <field name="education_level"/>
                            <field name="major"/>
                            <field name="school_name"/>
                            <field name="graduation_year"/>
                            <field name="current_job"/>
                            <field name="workplace"/>
                        </group>
                    </group>
                    <group string="Trình độ &amp; Mục tiêu">
                        <group>
                            <field name="english_level"/>
                            <field name="target_cert"/>
                            <field name="target_score"/>
                        </group>
                        <group>
                            <field name="date_enrollment"/>
                            <field name="date_start_study"/>
                            <field name="counselor_id" widget="many2one_avatar_user"/>
                            <field name="care_staff_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <group string="Ghi chú &amp; Tags">
                        <field name="tag_ids" widget="many2many_tags"
                               options="{'color_field':'color'}"/>
                        <field name="partner_id"/>
                        <field name="admission_id"/>
                    </group>
                    <notebook>
                        <page string="Phụ huynh / Bảo lãnh" name="parents">
                            <field name="parent_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="relationship"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="zalo"/>
                                    <field name="is_payer"/>
                                    <field name="is_primary_contact"/>
                                </list>
                            </field>
                        </page>
                        <page string="Đăng ký học" name="enrollments">
                            <field name="enrollment_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="course_id"/>
                                    <field name="class_id"/>
                                    <field name="date_enrolled"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="tuition_fee" widget="monetary"
                                           options="{'currency_field':'currency_id'}"/>
                                    <field name="amount_paid" widget="monetary"
                                           options="{'currency_field':'currency_id'}"/>
                                    <field name="payment_status" widget="badge"
                                           decoration-success="payment_status=='paid'"
                                           decoration-warning="payment_status=='partial'"
                                           decoration-danger="payment_status=='unpaid'"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state=='completed'"
                                           decoration-info="state=='studying'"
                                           decoration-warning="state=='on_leave'"
                                           decoration-danger="state in ('failed','cancelled')"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bảo lưu / Nghỉ học" name="leave"
                              invisible="state not in ('on_leave','dropped_out','graduated')">
                            <group>
                                <field name="date_leave_start"/>
                                <field name="date_leave_end"/>
                                <field name="leave_reason"/>
                                <field name="date_end_study"/>
                                <field name="drop_reason"/>
                            </group>
                        </page>
                        <page string="Mục tiêu học tập" name="goals">
                            <field name="learning_goal" placeholder="Mô tả mục tiêu học tập của học viên…"/>
                        </page>
                        <page string="Ghi chú nội bộ" name="notes">
                            <field name="note" placeholder="Ghi chú nội bộ (không hiện với học viên)…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List -->
    <record id="view_edu_student_list" model="ir.ui.view">
        <field name="name">edu.student.list</field>
        <field name="model">edu.student</field>
        <field name="arch" type="xml">
            <list string="Học viên"
                  decoration-success="state=='graduated'"
                  decoration-muted="state in ('dropped_out','suspended')"
                  decoration-warning="state=='on_leave'">
                <field name="image" widget="image" optional="show" width="38"/>
                <field name="student_code"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email" optional="hide"/>
                <field name="english_level" optional="show"/>
                <field name="date_enrollment"/>
                <field name="care_staff_id" widget="many2one_avatar_user" optional="show"/>
                <field name="enrollment_count"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field':'color'}" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state=='active'"
                       decoration-warning="state=='on_leave'"
                       decoration-info="state=='graduated'"
                       decoration-muted="state=='dropped_out'"/>
            </list>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_edu_student_kanban" model="ir.ui.view">
        <field name="name">edu.student.kanban</field>
        <field name="model">edu.student</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban">
                <field name="image"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="english_level"/>
                <field name="state"/>
                <field name="care_staff_id"/>
                <field name="tag_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click d-flex">
                            <field name="image" widget="image" class="o_image_64_cover me-2"/>
                            <div class="flex-grow-1">
                                <strong><field name="name"/></strong>
                                <div class="text-muted small"><field name="phone"/></div>
                                <div><field name="tag_ids" widget="many2many_tags"
                                            options="{'color_field':'color'}"/></div>
                                <div class="d-flex justify-content-between mt-1">
                                    <field name="state" widget="badge"/>
                                    <field name="care_staff_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search -->
    <record id="view_edu_student_search" model="ir.ui.view">
        <field name="name">edu.student.search</field>
        <field name="model">edu.student</field>
        <field name="arch" type="xml">
            <search string="Tìm học viên">
                <field name="name" string="Tên học viên"/>
                <field name="student_code" string="Mã học viên"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="care_staff_id"/>
                <separator/>
                <filter name="active_students" string="Đang học" domain="[('state','=','active')]"/>
                <filter name="on_leave" string="Bảo lưu" domain="[('state','=','on_leave')]"/>
                <filter name="graduated" string="Tốt nghiệp" domain="[('state','=','graduated')]"/>
                <filter name="dropped" string="Nghỉ học" domain="[('state','=','dropped_out')]"/>
                <separator/>
                <filter name="my_students" string="Học viên của tôi"
                        domain="[('care_staff_id','=',uid)]"/>
                <group >
                    <filter name="group_state" string="Trạng thái" context="{'group_by':'state'}"/>
                    <filter name="group_level" string="Trình độ" context="{'group_by':'english_level'}"/>
                    <filter name="group_care" string="Nhân viên chăm sóc" context="{'group_by':'care_staff_id'}"/>
                    <filter name="group_month" string="Tháng nhập học" context="{'group_by':'date_enrollment:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_edu_student_list" model="ir.actions.act_window">
        <field name="name">Học viên</field>
        <field name="res_model">edu.student</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_edu_student_search"/>
        <field name="context">{'search_default_active_students': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có học viên nào</p>
            <p>Tạo học viên mới hoặc chuyển từ hồ sơ tuyển sinh.</p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         edu.student.tag
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_edu_student_tag_list" model="ir.ui.view">
        <field name="name">edu.student.tag.list</field>
        <field name="model">edu.student.tag</field>
        <field name="arch" type="xml">
            <list string="Tags học viên" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_edu_student_tag" model="ir.actions.act_window">
        <field name="name">Tags học viên</field>
        <field name="res_model">edu.student.tag</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         edu.enrollment  –  Đăng ký học (standalone)
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_edu_enrollment_form" model="ir.ui.view">
        <field name="name">edu.enrollment.form</field>
        <field name="model">edu.enrollment</field>
        <field name="arch" type="xml">
            <form string="Đăng ký học">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="registered,studying,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="student_id"/>
                            <field name="class_id"/>
                            <field name="course_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_enrolled"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group string="Học phí">
                        <field name="admission_id"/>
                        <field name="tuition_fee" readonly="admission_id"/>
                        <field name="amount_paid" readonly="admission_id"
                               help="Tự động đồng bộ từ Sales Order/Invoice của hồ sơ tuyển sinh nếu có."/>
                        <field name="payment_status" widget="badge"
                               decoration-success="payment_status=='paid'"
                               decoration-warning="payment_status=='partial'"
                               decoration-danger="payment_status=='unpaid'"/>
                        <field name="currency_id"/>
                    </group>
                    <field name="note" placeholder="Ghi chú…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_edu_enrollment" model="ir.actions.act_window">
        <field name="name">Danh sách đăng ký học</field>
        <field name="res_model">edu.enrollment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
