<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Bước 1 của "Chăm sóc học viên": Điểm danh + Tiến độ học / % hoàn thành.
    File RIÊNG (không sửa trực tiếp seroto_course_views.xml) để dễ gỡ bỏ nếu cần -
    chỉ cần xoá file này + dòng đăng ký trong __manifest__.py là hết ảnh hưởng view.
  -->

  <!-- === Điểm danh === -->

  <record id="view_seroto_attendance_list" model="ir.ui.view">
    <field name="name">seroto.attendance.list</field>
    <field name="model">seroto.attendance</field>
    <field name="arch" type="xml">
      <list string="Điểm danh">
        <field name="date_session"/>
        <field name="class_id"/>
        <field name="session_id"/>
        <field name="enrollment_id" string="Học viên"/>
        <field
          name="state"
          widget="badge"
          decoration-success="state=='present'"
          decoration-info="state=='late'"
          decoration-danger="state=='absent'"
          decoration-warning="state=='excused'"
        />
        <field name="time_in" widget="float_time"/>
        <field name="time_out" widget="float_time"/>
        <field name="late_minutes"/>
        <field name="is_present" widget="boolean_toggle"/>
        <field name="parent_notified" string="Đã thông báo"/>
        <field name="note"/>
      </list>
    </field>
  </record>

  <record id="view_seroto_attendance_form" model="ir.ui.view">
    <field name="name">seroto.attendance.form</field>
    <field name="model">seroto.attendance</field>
    <field name="arch" type="xml">
      <form string="Điểm danh">
        <sheet>
          <group>
            <group string="Buổi học">
              <field name="session_id"/>
              <field name="class_id" readonly="1"/>
              <field name="date_session" readonly="1"/>
            </group>
            <group string="Học viên">
              <field name="enrollment_id" string="Học viên"
                     domain="[('class_id', '=', class_id)]"/>
              <field name="state"/>
              <field name="is_present" readonly="1"/>
            </group>
          </group>
          <group>
            <group string="Thời gian thực tế">
              <field name="time_in" widget="float_time"/>
              <field name="time_out" widget="float_time"/>
              <field name="late_minutes" readonly="1"/>
              <field name="note"/>
            </group>
            <group string="Thông báo">
              <field name="parent_notified"/>
            </group>
          </group>
          <group>
            <field name="recorded_by_id" readonly="1"/>
            <field name="recorded_at" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_seroto_attendance_search" model="ir.ui.view">
    <field name="name">seroto.attendance.search</field>
    <field name="model">seroto.attendance</field>
    <field name="arch" type="xml">
      <search string="Điểm danh">
        <field name="student_id"/>
        <field name="class_id"/>
        <field name="session_id"/>
        <filter string="Hôm nay" name="today"
                domain="[('date_session', '=', context_today().strftime('%Y-%m-%d'))]"/>
        <filter string="Vắng" name="absent" domain="[('is_present', '=', False)]"/>
        <group>
          <filter string="Lớp học" name="group_class" context="{'group_by': 'class_id'}"/>
          <filter string="Buổi học" name="group_session" context="{'group_by': 'session_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_seroto_attendance" model="ir.actions.act_window">
    <field name="name">Điểm danh</field>
    <field name="res_model">seroto.attendance</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_seroto_attendance_search"/>
    <field name="context">{'search_default_today': 1}</field>
  </record>

  <!--
    Thêm tab "Điểm danh" vào form Buổi học (không còn nút thống kê ở header - đã bỏ
    theo yêu cầu, xem toàn bộ điểm danh trực tiếp trong tab này).
  -->
  <record id="view_seroto_course_session_form_attendance" model="ir.ui.view">
    <field name="name">seroto.course.session.form.attendance</field>
    <field name="model">seroto.course.session</field>
    <field name="inherit_id" ref="seroto_form.view_seroto_course_session_form"/>
    <field name="arch" type="xml">
      <!-- Form Buổi học chưa có <notebook> nên thêm mới, làm con cuối của <sheet> -->
      <xpath expr="//sheet/group[1]" position="after">
        <notebook>
          <page string="Điểm danh">
            <field name="attendance_ids">
              <list>
                <field name="enrollment_id" string="Học viên"/>
                <field
                  name="state"
                  widget="badge"
                  decoration-success="state=='present'"
                  decoration-info="state=='late'"
                  decoration-danger="state=='absent'"
                  decoration-warning="state=='excused'"
                />
                <field name="time_in" widget="float_time"/>
                <field name="time_out" widget="float_time"/>
                <field name="late_minutes" readonly="1"/>
                <field name="note"/>
                <field name="parent_notified" string="Đã thông báo phụ huynh"/>
              </list>
            </field>
          </page>
        </notebook>
      </xpath>
    </field>
  </record>

  <!--
    LƯU Ý: KHÔNG kế thừa view_seroto_enrollment_form / view_seroto_enrollment_list ở
    đây - theo yêu cầu, giữ nguyên form/list "Đăng ký học" gốc như cũ. Field
    progress_percent/progress_label vẫn tồn tại trên model (dùng cho trang "Tiến độ
    học tập" riêng bên dưới), chỉ là không hiển thị chúng trên form Đăng ký học nữa.
  -->

  <!--
    === Trang "Chăm sóc" > "Tiến độ học tập" ===
    View RIÊNG (không dùng lại form/list Đăng ký học mặc định) - bố cục theo đúng mẫu:
    Học viên/Lớp học ở trên, rồi nhóm Chuyên cần / Kết quả học tập / Cờ chú ý /
    Nhận xét giáo viên. Vẫn là model seroto.enrollment (không tạo model care riêng).
  -->

  <record id="view_seroto_care_progress_list" model="ir.ui.view">
    <field name="name">seroto.enrollment.care.progress.list</field>
    <field name="model">seroto.enrollment</field>
    <!-- priority cao (mặc định là 16) để KHÔNG bao giờ bị Odoo tự chọn làm view mặc
         định cho seroto.enrollment ở nơi khác (vd nút "Đăng ký" trên Học viên) - view
         này chỉ được dùng khi action_seroto_care_progress trỏ đích danh qua view_ids. -->
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <list string="Tiến độ học tập">
        <field name="student_id"/>
        <field name="class_id"/>
        <field name="total_session_count" string="Tổng số buổi"/>
        <field name="attended_session_count" string="Số buổi đã học"/>
        <field name="progress_percent" widget="progressbar"/>
        <field name="completion_percent" widget="progressbar"/>
        <field name="average_score"/>
        <field name="latest_score"/>
        <field name="needs_special_care" widget="boolean_toggle" string="Cần chú ý"/>
        <field name="write_date" string="Cập nhật lần cuối"/>
      </list>
    </field>
  </record>

  <record id="view_seroto_care_progress_form" model="ir.ui.view">
    <field name="name">seroto.enrollment.care.progress.form</field>
    <field name="model">seroto.enrollment</field>
    <!-- priority cao, lý do giống view list ở trên -->
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <form string="Tiến độ học tập">
        <sheet>
          <group>
            <group>
              <field name="student_id"/>
              <field name="class_id"/>
            </group>
            <group string="Chuyên cần">
              <field name="total_session_count"/>
              <field name="attended_session_count"/>
              <field name="progress_percent" widget="progressbar"/>
              <field name="completion_percent" widget="progressbar"/>
            </group>
          </group>
          <group>
            <group string="Kết quả học tập">
              <field name="average_score"/>
              <field name="latest_score"/>
              <field name="write_date" string="Cập nhật lần cuối" readonly="1"/>
            </group>
            <group string="Cờ chú ý">
              <field name="needs_special_care" widget="boolean_toggle"
                     string="Cần chú ý / Chăm sóc đặc biệt"/>
            </group>
          </group>
          <group string="Nhận xét giáo viên">
            <field name="teacher_remark" nolabel="1"
                   placeholder="Nhận xét và đánh giá của giáo viên về học viên..."/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_seroto_care_progress" model="ir.actions.act_window">
    <field name="name">Tiến độ học tập</field>
    <field name="res_model">seroto.enrollment</field>
    <field name="view_mode">list,form</field>
    <field name="view_ids" eval="[
        (5, 0, 0),
        (0, 0, {'view_mode': 'list', 'view_id': ref('view_seroto_care_progress_list')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('view_seroto_care_progress_form')}),
    ]"/>
  </record>

</odoo>
