<odoo>
    <template id="course_register_modal" name="Course Register Modal">
        <div class="modal fade" id="courseRegisterModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Đăng ký khóa học</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" id="course_name"/>

                        <div class="mb-2">
                            <input class="form-control" id="student_name" placeholder="Họ tên"/>
                        </div>

                        <div class="mb-2">
                            <input class="form-control" id="phone" placeholder="Số điện thoại"/>
                        </div>

                        <div class="mb-2">
                            <input class="form-control" id="course_display" disabled/>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-primary" id="submit_course">Đăng ký</button>
                    </div>

                </div>
            </div>
        </div>
    </template>
</odoo>