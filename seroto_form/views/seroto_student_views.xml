<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- FORM VIEW -->
  <record id="view_seroto_student_form" model="ir.ui.view">
    <field name="name">seroto.student.form</field>
    <field name="model">seroto.student</field>
    <field name="arch" type="xml">
      <form string="Học viên">
        <header>
          <button
            name="action_set_active"
            type="object"
            string="Đăng ký học"
            class="oe_highlight"
            invisible="state != 'new'"
          />
          <button
            name="action_set_active"
            type="object"
            string="Tiếp tục học"
            class="oe_highlight"
            invisible="state not in ('on_leave', 'stop')"
          />
          <button
            name="action_set_on_leave"
            type="object"
            string="Bảo lưu"
            invisible="state not in ('active', 'stop')"
          />
          <button
            name="action_set_stop"
            type="object"
            string="Tạm dừng"
            invisible="state != 'active'"
          />
          <button
            name="action_set_completed"
            type="object"
            string="Hoàn thành"
            class="oe_highlight"
            invisible="state not in ('active')"
          />
          <field
            name="state"
            widget="statusbar"
            statusbar_visible="new,active,completed,on_leave,stop"
          />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button
              name="action_view_enrollments"
              type="object"
              class="oe_stat_button"
              icon="fa-book"
            >
              <field name="enrollment_count" widget="statinfo" string="Đăng ký"/>
            </button>
          </div>
          <field name="image" widget="image" class="oe_avatar"/>
          <div class="oe_title">
            <label for="student_code" string="Mã học viên"/>
            <h3>
              <field name="student_code" readonly="1"/>
            </h3>
            <label for="partner_id" string="Học viên"/>
            <h1>
              <field name="partner_id" placeholder="Họ và tên"/>
            </h1>
          </div>
          <group>
            <group string="Thông tin cá nhân">
              <field name="date_of_birth"/>
              <field name="age"/>
              <field name="gender"/>
            </group>
            <group string="Liên lạc">
              <field name="phone"/>
              <field name="email" widget="email"/>
            </group>
          </group>
          <group>          
            <group string="Chứng chỉ">
              <field name="certificate_type"/>
              <field name="date_of_issue"/>
              <field name="attachment_ids" widget="many2many_binary"/>
            </group>
          </group>
          <notebook>
            <page string="Đăng ký học" name="enrollments">
              <field name="enrollment_ids">
                <list>
                  <field name="name"/>
                  <field name="course_id"/>
                  <field name="class_id"/>
                  <field
                    name="tuition_fee"
                    widget="monetary"
                    options="{'currency_field': 'currency_id'}"
                  />
                  <field
                    name="payment_status"
                    widget="badge"
                    decoration-success="payment_status=='paid'"
                    decoration-warning="payment_status=='partical'"
                    decoration-danger="payment_status=='unpaid'"
                  />
                  <field
                    name="state"
                    widget="badge"
                    decoration-success="state=='completed'"
                    decoration-info="state=='studying'"
                    decoration-warning="state=='on_leave'"
                  />
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <!-- LIST VIEW -->
  <record id="view_seroto_student_list" model="ir.ui.view">
    <field name="name">seroto.student.list</field>
    <field name="model">seroto.student</field>
    <field name="arch" type="xml">
      <list string="Học viên">
        <field name="student_code"/>
        <field name="name"/>
        <field name="phone"/>
        <field name="email"/>
        <field name="enrollment_count"/>
        <field
          name="state"
          widget="badge"
          decoration-success="state=='completed'"
          decoration-info="state=='active'"
          decoration-warning="state=='on_leave'"
        />
      </list>
    </field>
  </record>

  <!-- KANBAN VIEW -->


  <!-- ACTIONS -->
  <record id="action_seroto_student" model="ir.actions.act_window">
    <field name="name">Học viên</field>
    <field name="res_model">seroto.student</field>
    <field name="view_mode">list,form</field>
  </record>


  <!-- === Đăng ký học === -->

  <!-- FORM VIEW -->
  <record id="view_seroto_enrollment_form" model="ir.ui.view">
    <field name="name">seroto.enrollment.form</field>
    <field name="model">seroto.enrollment</field>
    <field name="arch" type="xml">
      <form string="Đăng ký học">
        <header>
          <field
            name="state"
            widget="statusbar"
            statusbar_visible="registered,studying,completed"
          />
        </header>
        <sheet>
          <group>
            <group>
              <field name="name" readonly="1"/>
              <field name="student_id"/>
              <field name="class_id"/>
              <field name="course_id" readonly="1"/>
            </group>
            <group>
              <field name="state"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- LIST VIEW -->
  <record id="view_seroto_enrollment_list" model="ir.ui.view">
    <field name="name">seroto.enrollment.list</field>
    <field name="model">seroto.enrollment</field>
    <field name="arch" type="xml">
      <list string="Đăng ký học">
        <field name="name"/>
        <field name="student_id"/>
        <field name="class_id"/>
        <field name="course_id"/>
        <field
          name="state"
          widget="badge"
          decoration-success="state=='completed'"
          decoration-info="state=='studying'"
          decoration-warning="state=='on_leave'"
        />
      </list>
    </field>
  </record>

  <!-- ACTIONS -->
  <record id="action_seroto_enrollment" model="ir.actions.act_window">
    <field name="name">Danh sách đăng ký học</field>
    <field name="res_model">seroto.enrollment</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>