<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template
        id="course_page"
        name="Course Page">

        <t t-call="website.layout">

            <div id="wrap">

                <section class="container py-5">

                    <div class="row">

                        <t t-foreach="products"
                           t-as="product">

                            <div class="col-lg-4 mb-4">

                                <div class="card h-100 shadow-sm">

                                    <div class="card-body">

                                        <h4>

                                            <t t-esc="product.name"/>

                                        </h4>

                                        <p>

                                            <t t-esc="product.description_sale"/>

                                        </p>

                                        <h5 class="text-primary">

                                            <t t-esc="product.list_price"/>

                                        </h5>

                                        <button
                                            type="button"
                                            class="btn btn-primary register-course"
                                            t-att-data-course="product.name">

                                            Đăng ký

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </t>

                    </div>

                </section>

            </div>

        </t>

    </template>

</odoo>