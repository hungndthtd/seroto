<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Mã học viên: HV/00001 -->
    <record id="seq_seroto_student" model="ir.sequence">
      <field name="name">Học viên</field>
      <field name="code">seroto.student</field>
      <field name="prefix">HV/</field>
      <field name="padding">5</field>
      <field name="company_id" eval="False"/>
    </record>

    <!-- Mã đăng ký học: ENR/2024/00001 -->
    <record id="seq_seroto_enrollment" model="ir.sequence">
      <field name="name">Đăng ký học</field>
      <field name="code">seroto.enrollment</field>
      <field name="prefix">ENR/%(year)s/</field>
      <field name="padding">5</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
</odoo>