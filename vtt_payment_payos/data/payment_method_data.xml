<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_method_payos" model="payment.method">
        <field name="name">payOS</field>
        <field name="code">payos</field>
        <field name="sequence">10</field>
        <field name="image" type="base64" file="vtt_payment_payos/static/description/icon.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">none</field>
        <!-- payOS SDK hiện chưa xác nhận API hoàn tiền (xem comment
             _cron_reconcile_pending trong vtt_payos/models/payos_transaction.py) - khai
             đúng thực tế KHÔNG hỗ trợ, tránh Odoo hiện nút hoàn tiền không hoạt động được. -->
        <field name="support_refund">none</field>
    </record>

</odoo>
