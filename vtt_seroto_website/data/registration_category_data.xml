<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    5 LOẠI diện đăng ký (Tầng 1) - chỉ mang tính cấu trúc (có cần duyệt/upload không),
    KHÔNG có %/giá ở đây. Muốn áp dụng diện nào cho khóa học nào, với % giảm/mô tả/mẫu
    hồ sơ ra sao - vào đúng form Khóa học, tab "Diện đăng ký" (Tầng 2), tự thêm dòng.
  -->
  <record id="registration_category_hoc_phi" model="seroto.registration.category">
    <field name="name">Đóng học phí</field>
    <field name="code">hoc_phi</field>
    <field name="sequence">10</field>
  </record>

  <record id="registration_category_voucher" model="seroto.registration.category">
    <field name="name">Voucher quà tặng</field>
    <field name="code">voucher</field>
    <field name="sequence">20</field>
  </record>

  <record id="registration_category_hb_y_te" model="seroto.registration.category">
    <field name="name">Học bổng ngành y</field>
    <field name="code">hb_y_te</field>
    <field name="requires_review">True</field>
    <field name="requires_upload">True</field>
    <field name="sequence">30</field>
  </record>

  <record id="registration_category_hb_giao_duc" model="seroto.registration.category">
    <field name="name">Học bổng giáo dục</field>
    <field name="code">hb_giao_duc</field>
    <field name="requires_review">True</field>
    <field name="requires_upload">True</field>
    <field name="sequence">40</field>
  </record>

  <record id="registration_category_to_chuc_pldn" model="seroto.registration.category">
    <field name="name">Tổ chức phi lợi nhuận</field>
    <field name="code">to_chuc_pldn</field>
    <field name="requires_review">True</field>
    <field name="requires_upload">True</field>
    <field name="sequence">50</field>
  </record>
</odoo>
