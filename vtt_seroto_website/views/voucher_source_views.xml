<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_seroto_voucher_source_list" model="ir.ui.view">
    <field name="name">seroto.voucher.source.list</field>
    <field name="model">seroto.voucher.source</field>
    <field name="arch" type="xml">
      <list string="Nguồn voucher" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="action_seroto_voucher_source" model="ir.actions.act_window">
    <field name="name">Nguồn voucher</field>
    <field name="res_model">seroto.voucher.source</field>
    <field name="view_mode">list</field>
    <field name="context">{'active_test': False}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Chưa có nguồn voucher nào!
      </p>
      <p>
        Danh sách nguồn voucher hiện trên form đăng ký website (diện "Voucher quà tặng")
        - tự thêm bớt được ở đây, không cần lập trình lại.
      </p>
    </field>
  </record>

  <menuitem id="menu_seroto_voucher_source"
            name="Nguồn voucher"
            parent="seroto_education.menu_academic_group_report"
            action="action_seroto_voucher_source"
            sequence="35"/>

</odoo>
