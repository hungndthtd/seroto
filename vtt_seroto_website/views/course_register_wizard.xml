<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Modal đăng ký khóa học DẠNG NHIỀU BƯỚC (wizard):
    - Tab 1 "Thông tin cơ bản": Khóa học (readonly) + Họ tên/Email/SĐT (bắt buộc). Submit
      tab này gọi RPC tạo bản ghi seroto.course.registration thật (model/controller
      course_registration.py) + tạo link thanh toán payOS thật (module vtt_payos) + gửi
      email kèm link phiếu.
    - Tab 2 "Thanh toán": nút mở trang thanh toán payOS (checkout_url) ở tab/popup mới -
      JS polling trạng thái trong lúc chờ, TỰ chuyển sang "Thành công" khi webhook payOS
      báo về, KHÔNG có nút tự khai "Tôi đã thanh toán" (client không thể tự set trạng
      thái đã thanh toán được).
    - Tab 3 "Thông tin chuyên sâu": thu thập thêm thông tin sau khi đã thanh toán, lưu
      vào cùng bản ghi.
    Việc khoá/mở tab, disable nút "Tiếp tục" và gọi RPC xử lý ở
    static/src/js/course_register_wizard.js.
  -->
  <template id="course_register_wizard_modal">
    <div class="modal fade" id="courseRegisterWizardModal" tabindex="-1"
         aria-labelledby="courseRegisterWizardModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" style="max-width: 720px;">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title fw-bolder" id="courseRegisterWizardModalLabel">Đăng ký khóa học</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"/>
          </div>

          <div class="modal-body" style="padding: 24px 16px 30px;">
            <!--
              3 nút bước - mặc định chỉ "basic" là bấm được (2 nút còn lại có "disabled"
              sẵn trong HTML để phòng trường hợp JS lỗi/chưa kịp chạy thì tab sau vẫn
              không click được - JS chỉ gỡ "disabled" khi bước trước đã hoàn tất).
            -->
            <div class="course_wizard_steps">
              <button type="button" class="course_wizard_step active" data-step="basic">
                <span class="course_wizard_step_index">1</span>
                <span class="course_wizard_step_label">Thông tin cơ bản</span>
              </button>
              <button type="button" class="course_wizard_step" data-step="payment" disabled="disabled">
                <span class="course_wizard_step_index">2</span>
                <span class="course_wizard_step_label">Thanh toán</span>
              </button>
              <button type="button" class="course_wizard_step" data-step="detail" disabled="disabled">
                <span class="course_wizard_step_index">3</span>
                <span class="course_wizard_step_label">Thông tin chuyên sâu</span>
              </button>
            </div>

            <!-- Tab 1: Thông tin cơ bản (gồm cả "Diện đăng ký khóa học" - KHÔNG phải
                 bước riêng, gộp chung 1 form/1 lần submit, xem course_register_wizard.js
                 _onBasicSubmit/_onCategoryChange). Bố cục 2 cột (row/col-md-6) để đỡ dài
                 - tự xếp chồng lại thành 1 cột trên màn hình nhỏ (Bootstrap responsive). -->
            <div class="course_wizard_pane" data-pane="basic">
              <form id="course_wizard_basic_form" novalidate="novalidate">
                <div class="course_wizard_section_title">Thông tin cơ bản</div>
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label>Khóa học</label>
                    <input class="form-control" id="wizard_course_name" readonly="readonly"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Đăng ký cho</label>
                    <select class="form-control" name="student_relation" id="wizard_student_relation">
                      <option value="self" selected="selected">Bản thân</option>
                      <option value="other">Người khác</option>
                    </select>
                  </div>
                  <div id="wizard_student_fields" class="col-md-6 mb-3 d-none">
                    <label>Họ tên học viên</label>
                    <input class="form-control" name="student_name"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Họ tên người đăng ký</label>
                    <input class="form-control" name="name" required="required"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Email</label>
                    <input type="email" class="form-control" name="email" required="required"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Số điện thoại</label>
                    <input class="form-control" name="phone" required="required"/>
                  </div>
                </div>
                <div class="mb-3">
                  <label>Bạn đã học các khóa của Seroto trước đây chưa?</label>
                  <select class="form-control" name="has_studied_seroto_before">
                    <option value="no" selected="selected">Tôi chưa học bất cứ khóa học nào của Seroto</option>
                    <option value="yes">Tôi đã học</option>
                  </select>
                </div>
                <div class="form-check mb-3">
                  <input class="form-check-input" type="checkbox" name="commitment"
                         id="wizard_commitment" required="required"/>
                  <label class="form-check-label" for="wizard_commitment">
                    Tôi cam kết thông tin đăng ký trên là chính xác
                  </label>
                </div>

                <div class="course_wizard_section_title">Diện đăng ký khóa học</div>
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label>Diện đăng ký</label>
                    <select class="form-control" name="registration_category"
                            id="wizard_registration_category">
                      <option value="tuition" selected="selected">Diện đóng học phí</option>
                      <option value="voucher">Diện voucher quà tặng</option>
                      <option value="education_scholarship">Diện học bổng giáo dục</option>
                      <option value="medical_scholarship">Diện học bổng ngành y</option>
                      <option value="nonprofit">Diện tổ chức phi lợi nhuận</option>
                    </select>
                  </div>
                </div>
                <!-- Diện đóng học phí: KHÔNG có field riêng nào trên website - "Trạng
                     thái đăng ký" (sớm/bình thường) chỉ nhân viên tự chọn tay trên
                     backend (Phiếu đăng ký khóa học), mặc định 'normal' lúc tạo phiếu
                     (model default, xem models/course_registration.py). -->

                <!-- "Loại voucher" đã ẩn hẳn khỏi form - khách chỉ cần nhập đúng mã,
                     hệ thống tự xác định qua loyalty.card (xem _validate_voucher_code). -->
                <div id="wizard_category_voucher_fields" class="row d-none">
                  <div class="col-md-12 mb-3">
                    <label>Mã voucher</label>
                    <input class="form-control" name="voucher_code"/>
                  </div>
                </div>

                <!-- Dùng CHUNG cho 3 diện cần nộp giấy tờ (education_scholarship/
                     medical_scholarship/nonprofit) - hint text + link tải mẫu đổi theo
                     diện qua JS (_onCategoryChange). -->
                <div id="wizard_category_upload_fields" class="mb-3 d-none">
                  <label>Giấy tờ/tài liệu đính kèm</label>
                  <p class="text-muted small mb-2" id="wizard_category_upload_hint"/>
                  <a href="#" target="_blank" rel="noopener" class="d-block mb-2 d-none"
                     id="wizard_category_template_link">Tải mẫu giấy xác nhận</a>
                  <input type="file" class="form-control" name="category_attachment"
                         id="wizard_category_attachment_input" multiple="multiple"
                         />
                </div>

                <div id="wizard_category_medical_fields" class="row d-none">
                  <div class="col-md-6 mb-3">
                    <label>Tên cơ sở y tế</label>
                    <input class="form-control" name="medical_facility_name"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Cơ sở y tế thuộc tỉnh/thành phố</label>
                    <input class="form-control" name="medical_facility_province"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Vai trò</label>
                    <input class="form-control" name="medical_role"/>
                  </div>
                </div>

                <div id="wizard_category_nonprofit_fields" class="row d-none">
                  <div class="col-md-6 mb-3">
                    <label>Tên tổ chức</label>
                    <input class="form-control" name="nonprofit_org_name"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Trực thuộc tỉnh/thành phố</label>
                    <input class="form-control" name="nonprofit_org_province"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Thuộc xã/phường</label>
                    <input class="form-control" name="nonprofit_org_ward"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Vai trò của bạn tại tổ chức</label>
                    <input class="form-control" name="nonprofit_registrant_role"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Họ tên người ký giấy xác nhận</label>
                    <input class="form-control" name="nonprofit_signer_name"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Số điện thoại người ký giấy xác nhận</label>
                    <input class="form-control" name="nonprofit_signer_phone"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Họ tên người đại diện nhóm đăng ký</label>
                    <input class="form-control" name="nonprofit_representative_name"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Số điện thoại người đại diện nhóm đăng ký</label>
                    <input class="form-control" name="nonprofit_representative_phone"/>
                  </div>
                </div>

                <button type="submit" class="btn btn-success w-100 mt-3" id="wizard_basic_continue" disabled="disabled">
                  Tiếp tục
                </button>
              </form>
            </div>

            <!-- Tab 2: Thanh toán -->
            <div class="course_wizard_pane d-none" data-pane="payment">
              <div id="wizard_payment_pending">
                <div class="text-center mb-3" id="wizard_payment_qr_wrap">
                  <img id="wizard_payment_qr" class="course_wizard_qr_image" alt="Mã QR thanh toán"/>
                  <p class="text-muted small mt-2 mb-0">Quét mã bằng app ngân hàng bất kỳ</p>
                </div>

                <div class="course_wizard_section_title">Thông tin thanh toán</div>
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label>Khóa học</label>
                    <input class="form-control" id="wizard_payment_course" readonly="readonly"/>
                  </div>
                  <div class="col-md-6 mb-3 d-none" id="wizard_payment_student_row">
                    <label>Học viên</label>
                    <input class="form-control" id="wizard_payment_student" readonly="readonly"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Người đăng ký</label>
                    <input class="form-control" id="wizard_payment_name" readonly="readonly"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Email</label>
                    <input class="form-control" id="wizard_payment_email" readonly="readonly"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Số điện thoại</label>
                    <input class="form-control" id="wizard_payment_phone" readonly="readonly"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Diện đăng ký</label>
                    <input class="form-control" id="wizard_payment_category" readonly="readonly"/>
                  </div>
                  <div class="col-md-6 mb-3 d-none" id="wizard_payment_voucher_row">
                    <label>Voucher sử dụng</label>
                    <input class="form-control" id="wizard_payment_voucher" readonly="readonly"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Số tiền gốc</label>
                    <input class="form-control" id="wizard_payment_base_amount" readonly="readonly"/>
                  </div>
                  <div class="col-md-6 mb-3 d-none" id="wizard_payment_discount_row">
                    <label>Số tiền được giảm</label>
                    <input class="form-control" id="wizard_payment_discount_amount" readonly="readonly"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Số tiền cần thanh toán</label>
                    <input class="form-control" id="wizard_payment_amount" readonly="readonly"/>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label>Nội dung chuyển khoản</label>
                    <input class="form-control" id="wizard_payment_code" readonly="readonly"/>
                  </div>
                </div>
                <!-- Nội dung chuyển khoản hiển thị ở đây lấy đúng Mã phiếu (description
                     gửi cho payOS lúc tạo link, xem models/course_registration.py
                     _create_payment_transaction) - payOS/ngân hàng có thể tự thêm tiền tố
                     riêng vào nội dung chuyển khoản THẬT, nên vẫn ưu tiên nội dung hiển thị
                     trên trang/QR thanh toán thật nếu có sai khác. -->
                <p class="text-muted small mb-3" id="wizard_email_sent_note"/>
                <a href="#" target="_blank" rel="noopener" class="btn btn-success w-100 mb-2"
                   id="wizard_open_bank">
                  Mở trang thanh toán
                </a>
                <!-- Diện học bổng giáo dục/học bổng ngành y/tổ chức phi lợi nhuận - CHƯA
                     có link thanh toán tới khi nhân viên xác nhận giấy tờ (xem
                     controllers/course_registration.py, _requires_category_confirmation) -
                     ẩn QR/nút, hiện thông báo này thay vào đó (xem _onBasicSubmit, JS). -->
                <p class="text-muted small text-center mb-0 d-none mx-auto" style="max-width: 450px;"
                   id="wizard_payment_pending_confirmation_note">
                  Hồ sơ của bạn đang được nhân viên xác nhận thông tin/giấy tờ - Link thanh toán sẽ được gửi qua email ngay sau khi xác nhận xong.
                </p>
              </div>

              <div id="wizard_payment_success" class="d-none text-center">
                <p class="text-success fw-bold mb-2">
                  Thanh toán thành công
                </p>
                <p class="mb-5 mx-auto" style="font-size: 14px; max-width: 460px;">Đã hoàn tất thủ tục thanh toán, tiếp tục trả lời các câu hỏi chuyên sâu để hoàn thành phiếu đăng ký khóa học</p>
                <button type="button" class="btn btn-success w-100" id="wizard_payment_continue">
                  Tiếp tục
                </button>
              </div>

            </div>

            <!--
              Tab 3: Thông tin chuyên sâu - danh sách câu hỏi KHÁC NHAU theo từng khóa
              học (tab "Câu hỏi chuyên sâu" trên form Khóa học, module seroto_education).
              #course_wizard_questions_container rỗng lúc render server-side - JS
              (course_register_wizard.js, _renderQuestions) tự bơm 1 input/câu hỏi vào
              đây ngay sau khi tab "Thông tin cơ bản" hoàn tất (đã biết course + đã có
              danh sách câu hỏi trả về từ RPC create).
            -->
            <div class="course_wizard_pane d-none" data-pane="detail">
              <form id="course_wizard_detail_form">
                <div id="course_wizard_questions_container"/>
                <button type="submit" class="btn btn-success w-100">
                  Hoàn tất đăng ký
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </template>

  <!--
    "Phiếu đăng ký khóa học" - modal RIÊNG, xem lại/tiếp tục 1 lượt đăng ký đang dựng dở:
    - Chưa thanh toán: hiện lại khung Thanh toán (mở trang ngân hàng giả lập + polling)
      để hoàn tất thanh toán ngay trên phiếu.
    - Đã thanh toán: chỉ hiện Thông tin cơ bản + Thông tin chuyên sâu + trạng thái
      "Đã thanh toán" (ẩn khung thanh toán). JS tự polling khi phiếu đang mở và chưa
      thanh toán - xem static/src/js/course_register_wizard.js.
  -->
  <template id="course_registration_slip_modal">
    <div class="modal fade" id="courseRegistrationSlipModal" tabindex="-1"
         aria-labelledby="courseRegistrationSlipModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" style="max-width: 460px;">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="courseRegistrationSlipModalLabel">Phiếu đăng ký khóa học</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"/>
          </div>

          <div class="modal-body">
            <p class="mb-1">Khóa học: <strong id="slip_course"/></p>
            <p class="mb-1 d-none" id="slip_student_row">Học viên: <strong id="slip_student"/></p>
            <p class="mb-1">Người đăng ký: <strong id="slip_name"/></p>
            <p class="mb-1">Email: <strong id="slip_email"/></p>
            <p class="mb-1">Số điện thoại: <strong id="slip_phone"/></p>
            <div id="slip_answers" class="mb-1"/>
            <p class="mb-3">
              Trạng thái thanh toán:
              <span id="slip_payment_status" class="badge"/>
            </p>

            <div id="slip_payment_section" class="d-none">
              <hr/>
              <div class="text-center mb-3">
                <img id="slip_payment_qr" class="course_wizard_qr_image" alt="Mã QR thanh toán"/>
                <p class="text-muted small mt-2 mb-0">Quét mã bằng app ngân hàng bất kỳ</p>
              </div>
              <a href="#" target="_blank" rel="noopener" class="btn btn-success w-100 mb-2" id="slip_open_bank">
                Mở trang thanh toán
              </a>
              <p class="text-muted small text-center mb-0">
                <span class="spinner-border spinner-border-sm me-1" role="status"/>
                Đang chờ xác nhận thanh toán...
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </template>

  <!--
    Gắn 2 modal trên vào website.layout (con của #wrapwrap, NGOÀI #wrap) - lý do giống
    hệt seroto_form.course_register_modal_layout: nếu đặt trong 1 snippet có thể kéo
    thả/lưu (như s_trang_chu_course.xml), Website Builder sẽ đóng băng HTML lúc lưu
    trang, modal sẽ không còn tươi mới. Đặt "inside" #wrapwrap (không phải "before") để
    public widget (selector mặc định "#wrapwrap") tìm thấy được.
  -->
  <template id="course_register_wizard_layout" inherit_id="website.layout">
    <xpath expr="//div[@id='wrapwrap']" position="inside">
      <t t-call="vtt_seroto_website.course_register_wizard_modal"/>
      <t t-call="vtt_seroto_website.course_registration_slip_modal"/>
    </xpath>
  </template>

</odoo>
