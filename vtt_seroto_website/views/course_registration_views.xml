<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Backend: quản lý "Phiếu đăng ký khóa học" - phiếu từ website tự tạo ở trạng thái
    "Mới đăng ký" (xem controllers/course_registration.py, create_registration). NV
    cũng có thể tự tạo phiếu (trạng thái "Nháp") cho khách đăng ký qua điện thoại/Zalo
    ngoài luồng CRM thông thường. Thông tin khách đã điền qua web (họ tên/email/sđt/câu
    trả lời) chỉ sửa được khi phiếu còn "Nháp" - tránh làm lệch dữ liệu thật khách đã
    gửi (xem readonly trên form bên dưới).
  -->
  <record id="view_seroto_course_registration_list" model="ir.ui.view">
    <field name="name">seroto.course.registration.list</field>
    <field name="model">seroto.course.registration</field>
    <field name="arch" type="xml">
      <list string="Phiếu đăng ký khóa học">
        <field name="code"/>
        <field name="course_name"/>
        <field name="class_id" optional="show"/>
        <field name="student_name" string="Học viên (nếu đăng ký hộ)" optional="show"/>
        <field name="partner_name" string="Người đăng ký"/>
        <field name="phone"/>
        <field name="email"/>
        <field name="is_complete" optional="show"/>
        <field name="payment_status" widget="badge"
               decoration-success="payment_status == 'paid'"
               decoration-danger="payment_status == 'unpaid'"/>
        <field name="state" widget="badge"
               decoration-info="state in ('draft', 'new')"
               decoration-warning="state == 'confirmed'"
               decoration-success="state == 'completed'"
               decoration-danger="state in ('rejected', 'cancelled')"/>
        <field name="create_date" string="Ngày đăng ký"/>
      </list>
    </field>
  </record>

  <record id="view_seroto_course_registration_search" model="ir.ui.view">
    <field name="name">seroto.course.registration.search</field>
    <field name="model">seroto.course.registration</field>
    <field name="arch" type="xml">
      <search string="Phiếu đăng ký khóa học">
        <field name="code"/>
        <field name="course_name"/>
        <field name="course_id"/>
        <field name="partner_name"/>
        <field name="phone"/>
        <field name="email"/>
        <field name="payment_status"/>
        <filter string="Đã thanh toán" name="filter_paid"
                domain="[('payment_status', '=', 'paid')]"/>
        <filter string="Chưa thanh toán" name="filter_unpaid"
                domain="[('payment_status', '=', 'unpaid')]"/>
        <separator/>
        <filter string="Cần xử lý (Mới/Nháp)" name="filter_todo"
                domain="[('state', 'in', ('draft', 'new'))]"/>
        <filter string="Đã xác nhận" name="filter_confirmed"
                domain="[('state', '=', 'confirmed')]"/>
        <filter string="Hoàn tất" name="filter_completed"
                domain="[('state', '=', 'completed')]"/>
        <separator/>
        <filter string="Chưa đầy đủ thông tin" name="filter_incomplete"
                domain="[('is_complete', '=', False)]"/>
        <!--
          <group> trong search view KHÔNG hỗ trợ string/expand (khác form view - 2 view
          type này dùng chung định nghĩa <group> trong common.rng nhưng chỉ search mới
          bị validate theo schema RNG, "form" không nằm trong danh sách @validate() nên
          không bị chặn - đã kiểm chứng qua odoo/tools/view_validation.py +
          odoo/addons/base/rng/common.rng). Nhãn "Group By" tự hiện, không cần string.
        -->
        <group>
          <filter string="Khóa học" name="group_course" context="{'group_by': 'course_name'}"/>
          <filter string="Trạng thái phiếu" name="group_state" context="{'group_by': 'state'}"/>
          <filter string="Trạng thái thanh toán" name="group_payment_status"
                   context="{'group_by': 'payment_status'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_seroto_course_registration_form" model="ir.ui.view">
    <field name="name">seroto.course.registration.form</field>
    <field name="model">seroto.course.registration</field>
    <field name="arch" type="xml">
      <form string="Phiếu đăng ký khóa học" class="o_seroto_registration_form">
        <header>
          <button name="action_confirm" string="Xác nhận" type="object"
                  class="oe_highlight" invisible="state not in ('draft', 'new')"/>
          <button name="action_reject" string="Từ chối" type="object"
                  invisible="state not in ('draft', 'new')"/>
          <!-- Chỉ diện có requires_category_confirmation=True (đọc từ
               academic.registration.category.requires_review, xem
               _compute_requires_category_flags) - NV tự kiểm tra giấy tờ/thông tin đính
               kèm rồi mới bấm, popup confirm hỏi lại 1 lần trước khi áp mức giảm + tạo
               lại link thanh toán (xem action_confirm_category_discount). Tự ẩn sau khi
               đã xác nhận hoặc đã thanh toán - tránh bấm lại tạo trùng giao dịch không
               cần thiết (đổi discount_percent thì tự hiện lại, xem
               _onchange_discount_percent_reset_confirm). -->
          <field name="requires_category_confirmation" invisible="1"/>
          <button name="action_confirm_category_discount" string="Xác nhận thông tin đăng ký"
                  type="object" class="oe_highlight"
                  invisible="state not in ('draft', 'new') or payment_status == 'paid' or category_discount_confirmed or not requires_category_confirmation"
                  confirm="Xác nhận thông tin/giấy tờ/tài liệu chính xác và đầy đủ?"/>
          <!-- "Xác nhận" giờ tự tạo luôn Đơn hàng - nút này chỉ còn xuất hiện trong 1
               tình huống hiếm: hệ thống tự động (payOS) đã set trạng thái "Đã xác nhận"
               nhưng lỗi giữa chừng trước khi kịp tạo Đơn hàng, cần Sale tạo tay để khắc
               phục tiếp. -->
          <button name="action_create_sale_order" string="Tạo đơn hàng (khắc phục lỗi)" type="object"
                  class="oe_highlight" invisible="state != 'confirmed' or sale_order_id"/>
          <button name="action_cancel" string="Hủy phiếu" type="object"
                  invisible="state in ('completed', 'cancelled', 'rejected')"
                  confirm="Bạn có chắc chắn muốn hủy phiếu đăng ký này? Sau khi hủy, khách sẽ không thể đăng ký lại phiếu này và cần liên hệ CSKH nếu cần hoàn tiền."/>
          <field name="state" widget="statusbar" clickable="0"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_sale_order" type="object" class="oe_stat_button"
                    icon="fa-file-text-o" invisible="not sale_order_id">
              <div class="o_stat_info">
                <span class="o_stat_text">Đơn hàng</span>
              </div>
            </button>
          </div>
          <div class="oe_title">
            <span class="o_form_label text-muted">
              <field name="code" readonly="1"/>
            </span>
            <label for="course_name" string="Khóa học"/>
            <h1>
              <field name="course_name"/>
            </h1>
          </div>
          <group>
            <group string="Thông tin cơ bản">
              <field name="student_relation" readonly="state != 'draft'"/>
              <field name="student_name" readonly="state != 'draft'" invisible="student_relation == 'self'"/>
              <field name="partner_name" string="Họ tên người đăng ký" readonly="state != 'draft'"/>
              <field name="email" widget="email" readonly="state != 'draft'"/>
              <field name="phone" widget="phone" readonly="state != 'draft'"/>
              <field name="partner_id" invisible="not partner_id"/>
              <field name="slip_url" widget="CopyClipboardURL" string="Link phiếu"
                     class="o_seroto_slip_url"/>
              <!-- commitment_confirmed ẨN HẲN - không còn field UI riêng trên form
                   website nữa (field vẫn còn trong model để tương thích ngược dữ liệu
                   phiếu cũ), giao hẳn cho từng Khóa học tự cấu hình câu hỏi cam kết
                   (nếu cần) qua "Câu hỏi cơ bản" (xem tab dưới). -->
            </group>
            <group string="Khóa học / Lớp học">
              <field name="course_id" readonly="state != 'draft'"/>
              <field name="class_id"/>
              <field name="is_complete"/>
              <!-- has_studied_seroto_before ẨN HẲN - cùng lý do trên. -->
              <field name="currency_id" invisible="1"/>
              <field name="expected_amount"/>
            </group>
          </group>
          <group>
            <group string="Thanh toán">
              <field name="payment_status"
                     widget="badge"
                     decoration-success="payment_status == 'paid'"
                     decoration-danger="payment_status == 'unpaid'"/>
              <field name="payment_provider_label" readonly="1"/>
              <field name="payment_transaction_ref" readonly="1"/>
              <field name="payment_id"/>
            </group>
            <!-- Tách riêng thành 1 mục - registration_category CHO PHÉP nhân viên tự đổi
                (không readonly, không phụ thuộc state) để phân loại lại phiếu khi cần.
                CHỈ field đơn giản/upload nằm ở đây - field "thông tin điền thêm" của
                diện y tế/tổ chức phi lợi nhuận nằm ở tab "Thông tin theo diện đăng ký"
                (notebook bên dưới), theo đúng yêu cầu. -->
            <group string="Diện đăng ký khóa học">
              <field name="currency_id" invisible="1"/>
              <field name="requires_category_upload" invisible="1"/>
              <field name="registration_category"/>
              <field name="early_registration_status" invisible="registration_category != 'tuition'"/>
              <field name="early_price"
                     invisible="registration_category != 'tuition' or early_registration_status != 'early'"/>
              <!-- KHÔNG dùng widget="percentage" - widget đó quy ước field lưu dạng
                   phân số 0-1 (tự x100 lúc hiện/÷100 lúc lưu), trong khi discount_percent
                   lưu THẲNG số 0-100 giống hệt sale.order.line.discount (đã từng bị sai:
                   nhập 100 qua widget percentage lại lưu thành 1.0, chỉ giảm 1%). -->
              <field name="discount_percent"
                     invisible="registration_category not in ('education_scholarship', 'medical_scholarship', 'nonprofit')"/>
              <field name="category_discount_confirmed" readonly="1" widget="boolean_toggle"
                     invisible="not requires_category_confirmation"/>
              <!-- voucher_type ẩn hẳn - field vẫn còn trong model (tương thích ngược
                   dữ liệu phiếu cũ) nhưng không còn ai điền/hiển thị nữa. -->
              <!-- Nút "Kiểm tra" - gọi action_check_voucher_code() (model) để tra lại
                   ĐÚNG Phiếu giảm giá (loyalty.card) khớp mã, dùng khi nhân viên tự gõ
                   tay mã ở đây (không qua wizard website) - gõ tay đơn thuần vào field
                   Char này KHÔNG có onchange nào tự tra loyalty_card_id cả. -->
              <label for="voucher_code" invisible="registration_category != 'voucher'"/>
              <div class="o_row" invisible="registration_category != 'voucher'">
                <field name="voucher_code"/>
                <button name="action_check_voucher_code" type="object" icon="fa-search"
                        class="btn btn-secondary" title="Kiểm tra mã voucher" style="height: 28px; padding: 0 4px;"
                        help="Tra lại đúng Phiếu giảm giá (loyalty.card) khớp mã voucher vừa nhập."/>
              </div>
              <field name="loyalty_card_id" readonly="1" invisible="registration_category != 'voucher'"/>
              <field name="voucher_discount_amount" readonly="1" invisible="registration_category != 'voucher'"/>
              <field name="voucher_final_amount" readonly="1" invisible="registration_category != 'voucher'"/>
              <field name="category_attachment_ids" widget="many2many_binary"
                    invisible="not requires_category_upload"/>
            </group>
          </group>
          <group string="Lý do từ chối" invisible="state != 'rejected'">
            <field name="reject_reason" readonly="1" nolabel="1"/>
          </group>
          <notebook>
            <page string="Câu hỏi chuyên sâu">
              <field name="answer_ids">
                <list editable="bottom" create="false" delete="false">
                  <!-- force_save="1": field readonly nhưng PHẢI gửi kèm lúc lưu - không
                       có thuộc tính này, trình duyệt bỏ qua field readonly khi lưu các
                       dòng MỚI tạo qua onchange (_onchange_course_id_questions), gây lỗi
                       "Missing required value for the field 'Câu hỏi'" vì server nhận
                       vals không có "question" dù onchange đã gán sẵn giá trị. -->
                  <field name="question" readonly="1" force_save="1"/>
                  <field name="answer"/>
                </list>
              </field>
            </page>
            <page string="Câu hỏi cơ bản">
              <field name="basic_answer_ids">
                <list editable="bottom" create="false" delete="false">
                  <field name="question" readonly="1" force_save="1"/>
                  <field name="answer"/>
                </list>
              </field>
            </page>
            <!-- Chỉ "thông tin điền thêm" của diện y tế/tổ chức phi lợi nhuận nằm ở
                 đây - Trạng thái/Loại voucher/Mã voucher/giấy tờ đính kèm đã nằm ở mục
                 "Diện đăng ký khóa học" trên form chính (không lặp lại ở đây). Diện học
                 bổng giáo dục không có field riêng nào (chỉ cần giấy tờ đính kèm), nên
                 tab này tự ẩn với diện đó. category_info_ids (label/value) do
                 controllers/course_registration.py tự ghép lúc tạo phiếu - list
                 editable="bottom" y hệt answer_ids/"Câu hỏi chuyên sâu" ở trên. -->
            <page string="Thông tin theo diện đăng ký"
                  invisible="registration_category not in ('medical_scholarship', 'nonprofit')">
              <field name="category_info_ids">
                <list editable="bottom" create="false" delete="false">
                  <field name="label" readonly="1" force_save="1"/>
                  <field name="value"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_seroto_course_registration" model="ir.actions.act_window">
    <field name="name">Phiếu đăng ký khóa học</field>
    <field name="res_model">seroto.course.registration</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_seroto_course_registration_search"/>
    <field name="context">{'search_default_filter_todo': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Chưa có phiếu đăng ký nào!
      </p>
      <p>
        Phiếu đăng ký được tạo tự động khi khách hoàn tất bước "Thông tin cơ bản" ở nút
        "Đăng ký ngay" trên website. NV cũng có thể bấm "Mới" để tự tạo phiếu cho khách
        đăng ký qua điện thoại/Zalo.
      </p>
    </field>
  </record>

  <!--
    Đặt trong nhóm "Tuyển sinh & Vận hành" (menu_academic_group_operation) của app
    "Đào tạo" (seroto_education) - vtt_seroto_website đã khai seroto_education vào
    depends (xem __manifest__.py) để tham chiếu được menu cha này. Sequence=10, đứng
    TRƯỚC "Ghi danh" (20) vì đúng thứ tự vòng đời: đăng ký -> ghi danh -> điểm danh ->
    chứng chỉ.
  -->
  <menuitem id="menu_seroto_course_registration"
            name="Phiếu đăng ký"
            parent="seroto_education.menu_academic_group_operation"
            action="action_seroto_course_registration"
            sequence="10"/>

</odoo>
