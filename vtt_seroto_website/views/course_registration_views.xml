<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Backend: quản lý "Phiếu đăng ký khóa học" - tạo TỰ ĐỘNG ngay khi khách hoàn tất
    Tab 1 "Thông tin cơ bản" của wizard đăng ký trên website (xem
    controllers/course_registration.py, create_registration) - không cần thao tác gì
    thêm, dữ liệu đã có sẵn ở đây. create="false" + edit="false" trên cả 2 view bên
    dưới: phiếu chỉ để XEM, không tạo tay/sửa tay (dữ liệu phải khớp đúng những gì
    khách đã điền + trạng thái thanh toán do webhook xác thực, staff sửa tay dễ làm
    lệch dữ liệu thật).
  -->
  <record id="view_seroto_course_registration_list" model="ir.ui.view">
    <field name="name">seroto.course.registration.list</field>
    <field name="model">seroto.course.registration</field>
    <field name="arch" type="xml">
      <list string="Phiếu đăng ký khóa học" create="false" edit="false">
        <field name="course_name"/>
        <field name="partner_name"/>
        <field name="phone"/>
        <field name="email"/>
        <field name="payment_status" widget="badge"
               decoration-success="payment_status == 'paid'"
               decoration-danger="payment_status == 'unpaid'"/>
        <field name="create_date" string="Ngày đăng ký"/>
      </list>
    </field>
  </record>

  <record id="view_seroto_course_registration_search" model="ir.ui.view">
    <field name="name">seroto.course.registration.search</field>
    <field name="model">seroto.course.registration</field>
    <field name="arch" type="xml">
      <search string="Phiếu đăng ký khóa học">
        <field name="course_name"/>
        <field name="partner_name"/>
        <field name="phone"/>
        <field name="email"/>
        <field name="payment_status"/>
        <filter string="Đã thanh toán" name="filter_paid"
                domain="[('payment_status', '=', 'paid')]"/>
        <filter string="Chưa thanh toán" name="filter_unpaid"
                domain="[('payment_status', '=', 'unpaid')]"/>
        <!--
          <group> trong search view KHÔNG hỗ trợ string/expand (khác form view - 2 view
          type này dùng chung định nghĩa <group> trong common.rng nhưng chỉ search mới
          bị validate theo schema RNG, "form" không nằm trong danh sách @validate() nên
          không bị chặn - đã kiểm chứng qua odoo/tools/view_validation.py +
          odoo/addons/base/rng/common.rng). Nhãn "Group By" tự hiện, không cần string.
        -->
        <group>
          <filter string="Khóa học" name="group_course" context="{'group_by': 'course_name'}"/>
          <filter string="Trạng thái thanh toán" name="group_payment_status"
                   context="{'group_by': 'payment_status'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_seroto_course_registration_form" model="ir.ui.view">
    <field name="name">seroto.course.registration.form</field>
    <field name="model">seroto.course.registration</field>
    <field name="arch" type="xml">
      <form string="Phiếu đăng ký khóa học" create="false" edit="false" class="o_seroto_registration_form">
        <sheet>
          <div class="oe_title">
            <label for="course_name" string="Khóa học"/>
            <h1>
              <field name="course_name"/>
            </h1>
          </div>
          <group>
            <group string="Thông tin cơ bản">
              <field name="partner_name"/>
              <field name="email" widget="email"/>
              <field name="phone" widget="phone"/>
              <field name="slip_url" widget="CopyClipboardURL" string="Link phiếu"
                     class="o_seroto_slip_url"/>
            </group>
            <group string="Thanh toán">
              <field name="payment_status"
                     widget="badge"
                     decoration-success="payment_status == 'paid'"
                     decoration-danger="payment_status == 'unpaid'"/>
              <field name="bank_transaction_id"/>
            </group>
          </group>
          <notebook>
            <page string="Câu hỏi chuyên sâu">
              <field name="answer_ids" create="false" delete="false">
                <list editable="bottom">
                  <field name="question" readonly="1"/>
                  <field name="answer" readonly="1"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_seroto_course_registration" model="ir.actions.act_window">
    <field name="name">Phiếu đăng ký khóa học</field>
    <field name="res_model">seroto.course.registration</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_seroto_course_registration_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Chưa có phiếu đăng ký nào!
      </p>
      <p>
        Phiếu đăng ký được tạo tự động khi khách hoàn tất bước "Thông tin cơ bản" ở nút
        "Đăng ký ngay" trên website - không cần tạo tay ở đây.
      </p>
    </field>
  </record>

  <!--
    Đặt cạnh "Đợt học" (menu_academic_intake) trong app "Đào tạo" (seroto_education) -
    vtt_seroto_website đã khai seroto_education vào depends (xem __manifest__.py) để
    tham chiếu được menu cha này.
  -->
  <menuitem id="menu_seroto_course_registration"
            name="Phiếu đăng ký"
            parent="seroto_education.menu_academic_root"
            action="action_seroto_course_registration"
            sequence="55"/>

</odoo>
