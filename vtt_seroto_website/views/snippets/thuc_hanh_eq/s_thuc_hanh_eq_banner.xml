<?xml version="1.0" encoding="utf-8"?>

<odoo>
  <template id="s_thuc_hanh_eq_banner" name="Banner">
    <section class="s_thuc_hanh_eq_banner s_thuc_hanh_eq custom-snippet py-2" style="background: #46a8b1;">
      <div class="container-page">
        <div class="banner__box">
          <div class="banner__box-image">
            <div class="image__shape">
              <img src="/web/static/img/placeholder.png" alt="Thực hành EQ"
                class="img-fluid" style="max-height: 122px;"/>
            </div>
          </div>
          <div class="banner__box-content">
            <h3 class="text-white">Thực hành EQ</h3>
            <div class="content__action">
              <button type="button" class="btn-default js_register_course_wizard" data-course="Thực hành EQ">Đăng ký ngay</button>
              <div class="text-white text-lg fst-italic fw-bolder">Hạn chót đăng ký K49: 17h ngày 03/08</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </template>
</odoo>