      <div class="container-page">
        <div class="row">
          <div class="col-12">
            <div class="hero__box text-center mx-auto" style="max-width: 600px;">
              <div class="mb-4">
                <img src="/web/static/img/placeholder.png" alt="EQ MASTER"
