<?xml version="1.0" encoding="utf-8"?>

<odoo>
  <template id="s_cha_me_eq_con_eq_contact" name="Liên hệ">
    <section class="s_cha_me_eq_con_eq_contact s_cha_me_eq_con_eq custom-snippet pt48 pb48">
      <div class="container-page">
        <h2 class="title-custom mb-4 text-center" style="--space: 12px; --width: 100px;">Liên hệ</h2>
        <div class="row">
          <div class="col-12 col-md-6 mb-4 mb-md-0">
            <div class="contact__box">
              <div class="d-flex mb-4 mb-md-5">
                <img src="/web/static/img/placeholder.png" alt="Seroto"
                  class="img-fluid mx-auto" style="max-height: 30px; max-width: 30px;"/>
                <div class="ms-3 text-lg fst-italic" style="flex: 1;">"Con lớn lên từng ngày. Nếu cha mẹ không học cách đồng hành, chúng ta rất dễ bỏ lỡ những năm tháng quan trọng nhất trong đời con.”</div>
              </div>
              <div class="text-center">
                <button type="button" class="contact__button btn-default text-xl js_register_course_wizard" data-course="Cha mẹ EQ con EQ" style="--background: #ffb949; --background-hover: #f89f11;">Đăng ký ngay</button>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-6 mb-4 mb-md-0">
            <div class="contact__box">
              <div class="d-flex mb-4 mb-md-5">
                <img src="/web/static/img/placeholder.png" alt="Seroto"
                  class="img-fluid mx-auto" style="max-height: 30px; max-width: 30px;"/>
                <div class="ms-3 text-lg" style="flex: 1;">
                  Nếu muốn được gợi nhắc lịch đăng ký
                  <br/>
                  Mời bạn tham gia nhóm Zalo <b>"TÌM HIỂU KHÓA HỌC CHA MẸ EQ-CON EQ"</b>
                </div>
              </div>
              <div class="text-center">
                <div class="contact__button btn-default text-xl" style="--background: #41baff; --background-hover: #138cd1;">Nhóm Zalo</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </template>
</odoo>