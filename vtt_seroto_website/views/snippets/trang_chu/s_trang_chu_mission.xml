<?xml version="1.0" encoding="utf-8"?>

<odoo>
  <template id="s_trang_chu_mission" name="Sứ mệnh">
    <section class="s_trang_chu_mission s_trang_chu custom-snippet pt48 pb48">
      <div class="container-page">
        <div class="row align-items-center">
          <div class="col-12 col-md-6 mb-4 mb-md-0">
            <img src="/web/static/img/placeholder.png" alt="Seroto"
              class="img-fluid mx-auto" style="max-height: 280px;"/>
          </div>
          <div class="col-12 col-md-6">
            <div class="ms-md-auto" style="max-width: 435px;">
              <div class="title__special">
                <h3 class="text-orange font-lobster">Sứ mệnh</h3>
                <div class="title__special-arrow" style="height: 12px; width: 70px">
                  <t t-call="vtt_seroto_website.svg_multi_arrow">
                    <t t-set="svg_class" t-value="'text-green-light d-block'"/>
                  </t>
                </div>
              </div>
              <p class="mt-3">
                <b class="text-green">Seroto Foundation</b> theo đuổi một nền giáo dục hạnh phúc thực sự, giúp mỗi cá nhân trong cộng đồng có thể thấu hiểu bản thân, làm chủ cảm xúc, thực hành tỉnh thức để luôn có cuộc sống cân bằng và bình an nội tại.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </template>
</odoo>