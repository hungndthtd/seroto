<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============ Tầng 1: Loại diện đăng ký (cấu hình chung, hiếm khi đụng tới) ============ -->

  <record id="view_seroto_registration_category_list" model="ir.ui.view">
    <field name="name">seroto.registration.category.list</field>
    <field name="model">seroto.registration.category</field>
    <field name="arch" type="xml">
      <list string="Loại diện đăng ký">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="requires_review" widget="boolean_toggle"/>
        <field name="requires_upload" widget="boolean_toggle"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="action_seroto_registration_category" model="ir.actions.act_window">
    <field name="name">Loại diện đăng ký</field>
    <field name="res_model">seroto.registration.category</field>
    <field name="view_mode">list</field>
    <field name="context">{'active_test': False}</field>
    <field name="help" type="html">
      <p>
        Đây chỉ là DANH SÁCH LOẠI (cấu trúc, hiếm khi cần sửa). Muốn áp dụng diện nào cho
        khóa học nào, với % giảm/mô tả/mẫu hồ sơ riêng - vào form Khóa học, tab "Diện
        đăng ký".
      </p>
    </field>
  </record>

  <menuitem id="menu_seroto_registration_category"
            name="Loại diện đăng ký"
            parent="seroto_education.menu_academic_group_report"
            action="action_seroto_registration_category"
            sequence="30"/>

  <!-- ============ Tầng 2: Diện đăng ký áp dụng cho 1 khóa (tab trên form Khóa học) ============ -->

  <record id="view_academic_course_registration_category_list" model="ir.ui.view">
    <field name="name">academic.course.registration.category.list</field>
    <field name="model">academic.course.registration.category</field>
    <field name="arch" type="xml">
      <list string="Diện đăng ký" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="category_id"/>
        <field name="category_code" column_invisible="1"/>
        <field name="requires_review" column_invisible="1"/>
        <field name="discount_percent"/>
        <field name="early_bird_deadline" optional="show"/>
        <field name="early_bird_price" optional="show"/>
        <field name="template_link" optional="hide"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="view_academic_course_registration_category_form" model="ir.ui.view">
    <field name="name">academic.course.registration.category.form</field>
    <field name="model">academic.course.registration.category</field>
    <field name="arch" type="xml">
      <form string="Diện đăng ký">
        <sheet>
          <group>
            <group>
              <field name="category_id"/>
              <field name="category_code" invisible="1"/>
              <field name="discount_percent" invisible="category_code == 'hoc_phi'"/>
              <field name="active"/>
            </group>
            <group invisible="category_code != 'hoc_phi'" string="Giá sớm">
              <field name="early_bird_deadline"/>
              <field name="early_bird_price"/>
            </group>
          </group>
          <group invisible="not requires_upload" string="Mẫu hồ sơ">
            <field name="requires_upload" invisible="1"/>
            <field name="template_link" nolabel="1" placeholder="https://drive.google.com/..."/>
          </group>
          <group string="Mô tả ưu đãi (hiển thị trên form đăng ký website)">
            <field name="description" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!--
    Gắn thêm tab "Diện đăng ký" vào form Khóa học có sẵn (seroto_education) - dùng
    inherit_id thay vì sửa trong seroto_education, vì academic.course.registration.
    category (Tầng 2) tham chiếu sang model của module này (vtt_seroto_website) - seroto_
    education KHÔNG được phụ thuộc ngược lại module này.
  -->
  <record id="view_academic_course_form_registration_category" model="ir.ui.view">
    <field name="name">academic.course.form.registration.category</field>
    <field name="model">academic.course</field>
    <field name="inherit_id" ref="seroto_education.view_academic_course_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='page_questions']" position="after">
        <page string="Diện đăng ký">
          <field name="registration_category_line_ids" context="{'default_course_id': id}"/>
        </page>
      </xpath>
    </field>
  </record>

</odoo>
