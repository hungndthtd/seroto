<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Lưới an toàn bổ sung cho webhook - xem payos_transaction.py,
             _cron_reconcile_pending(). TẠM TẮT (active=False): chưa xác nhận được API
             tra cứu trạng thái link thanh toán trên SDK "payos" chính thức - bật lại sau
             khi hàm _cron_reconcile_pending() được hoàn thiện đầy đủ. -->
        <record id="ir_cron_payos_reconcile_pending" model="ir.cron">
            <field name="name">payOS: Đối soát giao dịch chờ thanh toán</field>
            <field name="model_id" ref="model_payos_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_reconcile_pending()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">False</field>
        </record>
    </data>
</odoo>
