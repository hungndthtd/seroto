<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_check_all_connections" model="ir.cron">
        <field name="name">Kết nối tích hợp: Tự kiểm tra định kỳ</field>
        <field name="model_id" ref="model_integration_connector"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_all_connections()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <!-- Tần suất cao hơn cron kiểm tra (10 phút) - Nhiệm vụ từ xa (VD Kỹ thuật bấm "Làm
         mới Token" từ xa cho site này) nên được thực thi sớm, không cần đợi đủ 1 giờ. Nếu
         chưa cấu hình Hub (hub_url/api_key trống) thì tự bỏ qua êm, không tốn gì. -->
    <record id="ir_cron_poll_remote_tasks" model="ir.cron">
        <field name="name">Kết nối tích hợp: Nhận lệnh từ Hub trung tâm</field>
        <field name="model_id" ref="model_integration_connector"/>
        <field name="state">code</field>
        <field name="code">model._cron_poll_remote_tasks()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
